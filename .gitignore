# build output
dist/
# generated types
.astro/
# wrangler local dev state (D1/KV emulation, etc.)
.wrangler/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
#
# Globbed rather than listed. The listed form covered .env and .env.production
# and missed .env.local, which is the one Vite's own documentation calls the
# place to put local secrets and describes as gitignored by default. A
# developer who believes that and is wrong commits a secret to a public repo.
.env
.env.*
!.env.example

# npm auth: .npmrc holds _authToken when a private registry is configured.
.npmrc

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler local dev vars (may hold secrets; .example is the committed template)
# Globbed for the same reason as .env above: `wrangler --env production` reads
# .dev.vars.production, which the bare name did not cover.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Agent worktrees. The harness creates one of these per background subagent so
# parallel agents cannot collide in the working tree, and removes it when the
# agent exits. They are full checkouts of this repo, so committing them would
# nest the repository inside itself.
.claude/worktrees/
