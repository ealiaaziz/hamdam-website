{
  "name": "hamdam-support",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "kb:generate": "node scripts/generate-kb.mjs",
    "predeploy:check": "node scripts/predeploy-check.mjs",
    "deploy": "node scripts/predeploy-check.mjs && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hamdam-support-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hamdam-support-db --remote"
  },
  "dependencies": {
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
