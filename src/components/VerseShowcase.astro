---
import type { ImageMetadata } from 'astro:assets';
import VerseCard from './VerseCard.astro';
import SceneBackground from './SceneBackground.astro';
import { verses } from '../data/verses';

interface Props {
  lang: 'en' | 'fa';
  intro: string;
  sceneImage?: ImageMetadata;
}

const { lang, intro, sceneImage } = Astro.props;

// Curated 3-up homepage showcase (unchanged since launch). verses.ts also
// now holds parvin-013/saadi-003 for the mood demo's 5-stop mapping
// (post-launch fix, 2026-07-19) -- pinned here by id so that addition
// doesn't silently grow this grid past its 3-column design.
const showcaseIds = ['hafez-016', 'rumi-011', 'parvin-008'];
const showcaseVerses = showcaseIds
  .map((id) => verses.find((v) => v.id === id))
  .filter((v): v is (typeof verses)[number] => v !== undefined);
---

<section class="verse-showcase">
  {sceneImage && <SceneBackground image={sceneImage} />}
  {
    /* The intro leads now (moved above the cards 2026-08-14). It was rendered
       below them, which made the sentence that frames the whole section --
       five poets, and the languages they can be read in -- read as a footnote
       to three verses the visitor had already had to interpret unaided. Same
       component API; only its position changed.

       The string itself changed 2026-08-16: "Two languages." -> "In Persian or
       English." Not false before, but ambiguous in the one direction the site
       was wrong in everywhere else, so it was made explicit while the rest of
       the presentation claim was corrected. See "Verse display" in FACTS.md. */
  }
  <p
    data-reveal
    class:list={[
      'verse-showcase__intro text-balance',
      lang === 'fa' ? 'font-farsi' : 'font-serif italic',
    ]}
  >
    {intro}
  </p>
  <div class="verse-showcase__grid" data-reveal-group>
    {
      showcaseVerses.map((verse) => (
        <VerseCard
          persian={verse.persian}
          translation={verse.english}
          poet={lang === 'fa' ? verse.poetFa : verse.poetEn}
        />
      ))
    }
  </div>
</section>

<style>
  /* Day arc, late day into golden hour (2026-08-14). Was transparent, i.e.
     page cream, sitting between a flat ember slab above and a flat dusk slab
     below -- the brightest of the three stripes the old page stacked here.
     It is now the bottom of the descent, and the last section before the
     dead-zone bridge into the poets' night. */
  .verse-showcase {
    position: relative;
    padding-inline: 1.5rem;
    padding-block: var(--spacing-section-mobile);
    background: linear-gradient(to bottom, var(--arc-lateday), var(--arc-goldenhour));
    color: var(--hamdam-text);
  }
  @media (min-width: 640px) {
    .verse-showcase {
      padding-block: var(--spacing-section-desktop);
    }
  }

  .verse-showcase__intro {
    position: relative;
    margin-inline: auto;
    margin-block-end: 3.5rem;
    max-width: 34rem;
    text-align: center;
    font-size: var(--text-h3);
    line-height: 1.6;
    /* Not --hamdam-text-soft and not an opacity step: on this section's own
       surface those measure 2.51:1 and fail outright. Hierarchy here comes
       from size and measure instead. See tokens.css. */
    color: var(--hamdam-text);
  }
  :global([lang='fa']) .verse-showcase__intro {
    line-height: 1.9;
  }

  .verse-showcase__grid {
    position: relative;
    margin-inline: auto;
    max-width: 72rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .verse-showcase__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
