---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  persianName: string;
  transliteration: string;
  description: string;
  lang: 'en' | 'fa';
  portrait: ImageMetadata;
  /** True for the desktop centre card (page spec §4 item 3: "centre card slightly larger"). */
  emphasized?: boolean;
  /**
   * Distance from the centre of the band, 0 (nearest the viewer) upward. Drives the
   * desktop depth staging below; ignored on mobile, where the band is a horizontal
   * scroller and there is no row to stage.
   */
  depth?: 0 | 1 | 2;
  class?: string;
}

const { persianName, transliteration, description, lang, portrait, emphasized = false, depth = 0, class: className = '' } = Astro.props;

const portraitAlt =
  lang === 'fa'
    ? `پرتره ${persianName} (برداشت هنری)`
    : `Portrait of ${transliteration} (artistic interpretation)`;
---

<div
  data-reveal
  class:list={[
    'poet-card group shrink-0 snap-center',
    emphasized && 'poet-card--emphasized',
    `poet-card--depth-${depth}`,
    className,
  ]}
>
  {
    /* PT-01 through PT-05: 14-canva-asset-brief.md portrait gallery band
       (§4), cultural approval granted 2026-07-18 (all five as one series
       per 22-dependency-decision.md). Persian name stays live text on its
       own caption plate, never baked into the portrait image. */
  }
  <div class="poet-card__portrait">
    <Image
      src={portrait}
      alt={portraitAlt}
      width={portrait.width}
      height={portrait.height}
      class="poet-card__portrait-img"
    />
    <div class="poet-card__plate">
      <h3 dir="rtl" class="poet-card__name font-farsi">{persianName}</h3>
    </div>
  </div>
  <p class="poet-card__translit">{transliteration}</p>
  <p class="poet-card__description font-serif italic">{description}</p>
</div>

<style>
  .poet-card {
    width: 220px;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
  }
  .poet-card--emphasized {
    width: 248px;
  }
  @media (min-width: 640px) {
    .poet-card {
      width: 240px;
    }
    .poet-card--emphasized {
      width: 272px;
    }
  }

  /* Desktop depth staging (2026-08-07). Five portraits in a flat row read as five
     competing subjects; the same five staged at three distances read as a gallery
     wall, with the centre voice nearest. The vertical stagger that was already here
     looked like a misalignment because nothing explained it -- given real depth it
     becomes the reason for itself. Mobile is a scroll-snap carousel with one card in
     view at a time, so there is no row to stage and this stays desktop-only. */
  @media (min-width: 1024px) {
    .poet-card {
      transition: transform 300ms var(--ease-settle);
    }
    .poet-card--depth-1 {
      transform: translateZ(-55px);
    }
    .poet-card--depth-2 {
      transform: translateZ(-110px);
    }
    /* Aerial perspective: the further a thing is through air, the less contrast it
       holds and the more it takes the colour of what it is seen through -- here the
       band's own dusk. Kept shallow so every portrait stays clearly readable; this
       is depth, not de-emphasis. */
    .poet-card--depth-1 .poet-card__portrait-img {
      filter: brightness(0.93) saturate(0.94);
    }
    .poet-card--depth-2 .poet-card__portrait-img {
      filter: brightness(0.87) saturate(0.88);
    }
    /* Hovering brings a portrait forward out of the wall, so a visitor can pull any
       of the five to the front rather than only being offered the centre. */
    .poet-card:hover,
    .poet-card:focus-within {
      transform: translateZ(0);
    }
    @media (prefers-reduced-motion: reduce) {
      .poet-card {
        transition: none;
      }
    }
  }

  .poet-card__portrait {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-card);
    background: linear-gradient(160deg, var(--surface-dusk), var(--surface-firstlight));
    box-shadow: var(--elev-night-2);
    overflow: hidden;
    transition: box-shadow 150ms var(--ease-cross), transform 150ms var(--ease-cross);
  }
  .poet-card__portrait-img {
    transition: filter 300ms var(--ease-cross);
  }
  .poet-card__portrait-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .group:hover .poet-card__portrait,
  .group:focus-within .poet-card__portrait {
    transform: translateY(-4px);
    /* --shadow-lift is the warm daylight elevation and all but disappears against
       this band's dusk surface; the night scale carries the same direction in a
       shade that actually reads here. */
    box-shadow: 0 0 48px var(--glow-warm), var(--elev-night-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .poet-card__portrait {
      transition: none;
    }
    .group:hover .poet-card__portrait,
    .group:focus-within .poet-card__portrait {
      transform: none;
      /* --color-saffron-ink is tuned for cream; the poets band sits on
         --surface-dusk, where it measures 2.60:1 (Phase 11/12 contrast
         audit) -- below the 3:1 non-text minimum. --hamdam-night-gold
         gives 9.52:1 here. */
      box-shadow: 0 0 0 2px var(--hamdam-night-gold), var(--shadow-rest);
    }
  }

  .poet-card__plate {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    background: rgb(20 20 48 / 0.72);
    padding: 0.75rem 0.5rem;
    text-align: center;
  }
  .poet-card__name {
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--text-on-night);
  }

  .poet-card__translit {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    /* --color-saffron-ink is darkened specifically for cream backgrounds;
       the poets band sits on --surface-dusk (dark), so this needs the
       night-surface accent pairing instead (design-system.md §1). */
    color: var(--hamdam-night-gold);
  }

  .poet-card__description {
    margin-top: 0.5rem;
    text-align: center;
    font-size: var(--text-body);
    color: var(--text-on-night);
  }
</style>
