---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  persianName: string;
  transliteration: string;
  description: string;
  lang: 'en' | 'fa';
  portrait: ImageMetadata;
  /** True for the desktop centre card (page spec §4 item 3: "centre card slightly larger"). */
  emphasized?: boolean;
  /** The poet's own page. Added 2026-08-07 with the poet cluster: the card
   *  itself stays non-interactive per page spec §4 item 10 ("no conversion
   *  action, this section builds authority"), so only the transliteration
   *  becomes a link. That keeps the band's behaviour as designed while giving
   *  the five new pages a crawlable route in from the homepage, which they
   *  otherwise would not have. */
  href?: string | null;
  class?: string;
}

const { persianName, transliteration, description, lang, portrait, emphasized = false, href = null, class: className = '' } = Astro.props;

const portraitAlt =
  lang === 'fa'
    ? `پرتره ${persianName} (برداشت هنری)`
    : `Portrait of ${transliteration} (artistic interpretation)`;
---

<div
  data-reveal
  class:list={[
    'poet-card group shrink-0 snap-center',
    emphasized && 'poet-card--emphasized',
    className,
  ]}
>
  {
    /* PT-01 through PT-05: 14-canva-asset-brief.md portrait gallery band
       (§4), cultural approval granted 2026-07-18 (all five as one series
       per 22-dependency-decision.md). Persian name stays live text on its
       own caption plate, never baked into the portrait image. */
  }
  <div class="poet-card__portrait">
    <Image
      src={portrait}
      alt={portraitAlt}
      width={portrait.width}
      height={portrait.height}
      class="poet-card__portrait-img"
    />
    <div class="poet-card__plate">
      <h3 dir="rtl" class="poet-card__name font-farsi">{persianName}</h3>
    </div>
  </div>
  <p class="poet-card__translit">
    {href ? <a class="poet-card__link" href={href}>{transliteration}</a> : transliteration}
  </p>
  <p class="poet-card__description font-serif italic">{description}</p>
</div>

<style>
  .poet-card__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .poet-card__link:hover,
  .poet-card__link:focus-visible {
    text-decoration: underline;
    color: var(--hamdam-night-gold);
  }

  .poet-card {
    width: 220px;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
    /* Perspective for the portrait's hover lift below. Short enough that the
       tilt is legible on a 240px card, long enough that the frame does not
       visibly keystone -- these are paintings, and a portrait that skews reads
       as a mistake rather than as depth. */
    perspective: 900px;
  }
  .poet-card--emphasized {
    width: 248px;
  }
  /* 220 x 3/2 = 330, the height every non-emphasized portrait resolves to
     from its aspect ratio at this breakpoint. This pin used to live only
     inside the min-width: 640px block, so below 640 the emphasized card
     still rendered a 372px portrait beside 330px neighbours and kept the
     exact 42px baseline offset the change was meant to remove. */
  .poet-card--emphasized .poet-card__portrait {
    aspect-ratio: auto;
    height: 330px;
  }
  @media (min-width: 640px) {
    .poet-card {
      width: 240px;
    }
    .poet-card--emphasized {
      width: 272px;
    }
    /* 240 x 3/2 = 360, the same arithmetic at the wider breakpoint. */
    .poet-card--emphasized .poet-card__portrait {
      height: 360px;
    }
  }

  /* One baseline across the row (2026-08-14). Emphasis used to come from
     aspect-ratio plus a wider card, which made the centre portrait 408px
     tall against its neighbours' 360px. Everything below it -- the
     transliteration, the description -- was pushed down by 48px, so the row
     read as five misaligned cards rather than one row with a centre.
     Emphasis is now width alone: the centre card is a wider crop of the same
     portrait at the same height, so the names and descriptions share a
     baseline and the emphasis still reads. */
  .poet-card__portrait {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-card);
    background: linear-gradient(160deg, var(--surface-dusk), var(--surface-firstlight));
    box-shadow: var(--shadow-rest);
    overflow: hidden;
    transition: box-shadow 150ms var(--ease-cross), transform 150ms var(--ease-cross);
  }
  .poet-card__portrait-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  /* The lift happens in depth now (2026-08-15): the portrait steps toward the
     reader and tips its top edge back, so the card catches the light the way a
     framed painting on a wall does when you lean in. It was a flat 4px nudge
     upward, which at this size was barely perceptible as anything at all.
     translateZ does the approach and rotateX the tip; both are composited, so
     this stays on the same GPU path the nudge was on and still triggers no
     layout. */
  .group:hover .poet-card__portrait,
  .group:focus-within .poet-card__portrait {
    transform: translate3d(0, -4px, 26px) rotateX(4deg);
    box-shadow: 0 0 48px var(--glow-warm), var(--shadow-lift);
  }
  @media (prefers-reduced-motion: reduce) {
    .poet-card__portrait {
      transition: none;
    }
    .group:hover .poet-card__portrait,
    .group:focus-within .poet-card__portrait {
      transform: none;
      /* --color-saffron-ink is tuned for cream; the poets band sits on
         --surface-dusk, where it measures 2.60:1 (Phase 11/12 contrast
         audit) -- below the 3:1 non-text minimum. --hamdam-night-gold
         gives 9.52:1 here. */
      box-shadow: 0 0 0 2px var(--hamdam-night-gold), var(--shadow-rest);
    }
  }

  .poet-card__plate {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    background: rgb(20 20 48 / 0.72);
    padding: 0.75rem 0.5rem;
    text-align: center;
  }
  .poet-card__name {
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--text-on-night);
  }

  .poet-card__translit {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    /* --color-saffron-ink is darkened specifically for cream backgrounds;
       the poets band sits on --surface-dusk (dark), so this needs the
       night-surface accent pairing instead (design-system.md §1). */
    color: var(--hamdam-night-gold);
  }

  .poet-card__description {
    margin-top: 0.5rem;
    text-align: center;
    font-size: var(--text-body);
    color: var(--text-on-night);
  }
</style>
