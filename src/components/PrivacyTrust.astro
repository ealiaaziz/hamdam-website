---
import { Image } from 'astro:assets';
import deviceFrame from '../assets/website-redesign/device-frame-iphone.png';
import privacyScreenshotEn from '../assets/website-redesign/screenshots/EN/06-privacy-en.png';
import privacyScreenshotFa from '../assets/website-redesign/screenshots/FA/06-privacy-fa.png';
import { CONTEXT_SIGNALS, CONTEXT_SIGNAL_ICONS } from '../data/contextSignals';

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;
const privacyScreenshot = lang === 'fa' ? privacyScreenshotFa : privacyScreenshotEn;

// Every clause here is traceable to the live Privacy Policy (page spec §8
// item 4): the primary statement mirrors /privacy's own opening
// paragraph; the trust row's three items map to "no accounts" (§2),
// "on your device" (§1's opening: "a small set of signals, on your own
// device"), and "your own iCloud only" (§1.4, opt-in, CloudKit Private
// Database, scoped to the visitor's own Apple ID).
const copy =
  lang === 'fa'
    ? {
        statement: 'همدم از حساب کاربری استفاده نمی‌کند. ایمیلی جمع‌آوری نمی‌کند. کلمات تو هرگز از دستگاهت خارج نمی‌شوند، مگر اینکه خودت همگام‌سازی iCloud را روشن کنی. هیچ‌کس در همدم نمی‌تواند حتی یک کلمه از نوشته‌های تو را بخواند.',
        trust: [
          { title: 'بدون حساب کاربری', body: 'بدون ثبت‌نام، بدون ایمیل.' },
          { title: 'روی دستگاه خودت', body: 'سیگنال‌ها همان‌جا که خوانده شدند می‌مانند.' },
          {
            title: 'فقط iCloud خودت',
            body: 'همگام‌سازی اختیاری است، فقط برای Apple ID خودت، و به همدم پلاس نیاز دارد.',
          },
        ],
        links: { privacy: 'حریم خصوصی', terms: 'شرایط استفاده' },
        deviceAlt: 'صفحه حریم خصوصی همدم، با فهرست نشانه‌هایی که خوانده می‌شوند و کلید خاموش‌کردن هرکدام',
        // Reused byte-exact from ContextConstellation's own heading, which this
        // section absorbed when the homepage went to seven sections. No new Farsi.
        signalsHeading: 'یک تأمل، شکل‌گرفته از روز تو.',
      }
    : {
        statement: 'Hamdam does not use accounts. It does not collect emails. Your words never leave your device unless you turn on your own iCloud sync. Nobody at Hamdam can read a word you write.',
        trust: [
          { title: 'No accounts', body: 'No sign-up, no email at all.' },
          { title: 'On your device', body: 'Signals stay where they were read.' },
          {
            title: 'Your own iCloud only',
            body: 'Sync is opt-in, scoped to your Apple ID, and requires Hamdam Plus.',
          },
        ],
        links: { privacy: 'Privacy Policy', terms: 'Terms of Use' },
        deviceAlt: 'Hamdam Privacy screen, listing each signal it reads with a switch to turn any of them off',
        signalsHeading: 'One reflection, shaped by your day.',
      };

const TRUST_ICONS = [
  'M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z', // no accounts: shield outline (nothing to sign into)
  'M7 4h10a1 1 0 011 1v14a1 1 0 01-1 1H7a1 1 0 01-1-1V5a1 1 0 011-1zM10 18h4', // on your device: phone
  'M7 17a4 4 0 010-8 5 5 0 019.6-1.5A4 4 0 0117 17H7z', // your own iCloud: cloud
];

const privacyHref = lang === 'fa' ? '/fa/privacy/' : '/privacy/';
const termsHref = lang === 'fa' ? '/fa/terms/' : '/terms/';
---

<section id="privacy" class="privacy-trust" aria-labelledby="privacy-trust-title">
  {
    /* Three bands, not one 60ch column beside a phone (restructured
       2026-08-14). At 1440 the section reserved 1200px and used about 530 of
       it: the statement, the three trust items, the six signals and the legal
       links all queued up inside one narrow column while the device sat at
       the top right and roughly 700px of the section was empty ember, with
       another 300px of it below the links. The lede keeps the phone beside
       it, since that pairing is the point; the six signals -- which are a
       six-item list, not a column of prose -- now use the width they were
       always being denied. */
  }
  <div class="privacy-trust__inner">
    <div class="privacy-trust__lede">
      <p id="privacy-trust-title" class="privacy-trust__statement text-balance">{copy.statement}</p>

      <ul class="privacy-trust__row" data-reveal-group>
        {copy.trust.map((item, i) => (
          <li class="privacy-trust__item" data-reveal>
            <svg class="privacy-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={TRUST_ICONS[i]} />
            </svg>
            <span class="privacy-trust__item-title">{item.title}</span>
            <span class="privacy-trust__item-body">{item.body}</span>
          </li>
        ))}
      </ul>

      {
        /* The six signals Hamdam reads, folded in here 2026-07-25 from what was
           its own homepage section. Each one is a claim about what is read and
           what is done with it, which is the same claim this section makes, so
           they support the statement above instead of competing with it a
           screen earlier. Data is shared, not duplicated: src/data/contextSignals.ts. */
      }
    </div>

    <div class="privacy-trust__signals-block">
      <h3 class="privacy-trust__signals-heading text-balance">{copy.signalsHeading}</h3>
      <ul class="privacy-trust__signals" data-reveal-group>
        {CONTEXT_SIGNALS.map((signal) => (
          <li class="privacy-trust__signal" data-reveal>
            <svg class="privacy-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={CONTEXT_SIGNAL_ICONS[signal.id]} />
            </svg>
            <span class="privacy-trust__item-title">{lang === 'fa' ? signal.labelFa : signal.labelEn}</span>
            <span class="privacy-trust__item-body">{lang === 'fa' ? signal.clauseFa : signal.clauseEn}</span>
          </li>
        ))}
      </ul>
    </div>

    <nav class="privacy-trust__links" aria-label={copy.links.privacy}>
      <a href={privacyHref}>{copy.links.privacy}</a>
      <a href={termsHref}>{copy.links.terms}</a>
    </nav>

    {
      /* Real orchestrator 06-privacy screenshot composited 2026-07-19,
         same cutout-position math as every other DV-01 consumer -- see
         HeroCinematic.astro's .hero__device-screen comment for the
         measurement method. */
    }
    <div class="privacy-trust__device" role="img" aria-label={copy.deviceAlt}>
      <Image
        src={privacyScreenshot}
        alt=""
        width={525}
        height={1140}
        quality={80}
        class="privacy-trust__device-screen"
      />
      <Image
        src={deviceFrame}
        alt=""
        width={480}
        height={Math.round((480 / deviceFrame.width) * deviceFrame.height)}
        quality={72}
        class="privacy-trust__device-frame"
      />
    </div>
  </div>
</section>

<style>
  /* Day arc, sunrise into apricot (2026-08-14): the first two steps of the
     climb back to morning. Was flat --surface-dawn. Dark text still, and
     still without an opacity step anywhere in this file -- the reasoning in
     the item-body rule below holds for every stop from afternoon to sunrise,
     not just for --surface-dawn. */
  .privacy-trust {
    padding-block: var(--spacing-section-mobile);
    padding-inline: 1.5rem;
    background: linear-gradient(to bottom, var(--arc-sunrise), var(--arc-apricot));
    color: var(--hamdam-text);
  }
  @media (min-width: 640px) {
    .privacy-trust {
      padding-block: var(--spacing-section-desktop);
    }
  }

  .privacy-trust__inner {
    max-width: 1200px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: center;
    text-align: center;
  }

  .privacy-trust__lede {
    max-width: 60ch;
  }

  .privacy-trust__signals-block {
    width: 100%;
  }

  .privacy-trust__statement {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: 1.3;
  }
  :global([lang='fa']) .privacy-trust__statement {
    font-family: var(--font-farsi);
    font-weight: 500;
  }

  .privacy-trust__row {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 640px) {
    .privacy-trust__row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .privacy-trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .privacy-trust__icon {
    width: 28px;
    height: 28px;
    /* --color-ember reads near-invisibly close to this section's own
       --surface-dawn background (Phase 7's constellation had the same
       bug) -- use the body text colour for real contrast instead. */
    color: var(--hamdam-text);
  }

  .privacy-trust__item-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-body);
  }
  :global([lang='fa']) .privacy-trust__item-title {
    font-family: var(--font-farsi);
  }

  .privacy-trust__item-body {
    font-size: var(--text-meta);
    /* No opacity reduction, same reasoning as ContextConstellation's
       node-clause fix: --hamdam-text is only 5.13:1 on --surface-dawn,
       and any opacity reduction drops this small text below 4.5:1. */
  }

  /* The six absorbed signals: a quieter, denser row than the three trust
     claims above, so it reads as supporting detail rather than a second
     headline. Same item typography, three columns instead of one per claim. */
  /* No top margin: the block is its own grid row now and the container's
     row-gap does this spacing. Keeping both stacked 3.5rem on top of 4rem. */
  .privacy-trust__signals-heading {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 600;
  }
  :global([lang='fa']) .privacy-trust__signals-heading {
    font-family: var(--font-farsi);
    font-weight: 500;
  }

  .privacy-trust__signals {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 480px) {
    .privacy-trust__signals {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .privacy-trust__signals {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .privacy-trust__signal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }

  .privacy-trust__links {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
    gap: 2rem;
  }
  .privacy-trust__links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--hamdam-text);
  }

  .privacy-trust__device {
    position: relative;
    width: min(200px, 50vw);
    aspect-ratio: 1290 / 2796;
    border-radius: var(--radius-device);
    background: linear-gradient(to bottom, var(--surface-dusk), var(--surface-firstlight));
    box-shadow: var(--shadow-rest);
    overflow: hidden;
  }
  .privacy-trust__device-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .privacy-trust__device-screen {
    /* Explicit width/height, not auto + all four insets -- see
       JourneyPair.astro's .journey__frame-screen comment for why (replaced-
       element over-constraint bug, confirmed live: insets were silently
       not shrinking the image at all). */
    position: absolute;
    top: 5.97%;
    left: 6.43%;
    width: 87.5%;
    height: 87.62%;
    object-fit: cover;
    border-radius: 8%;
  }

  @media (min-width: 1024px) {
    .privacy-trust__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'lede   device'
        'signals signals'
        'links  links';
      column-gap: 3rem;
      row-gap: 4rem;
      align-items: center;
      text-align: start;
    }
    .privacy-trust__lede {
      grid-area: lede;
    }
    .privacy-trust__signals-block {
      grid-area: signals;
    }
    .privacy-trust__links {
      grid-area: links;
      margin-top: 0;
      justify-content: flex-start;
    }
    .privacy-trust__device {
      grid-area: device;
    }
    .privacy-trust__row {
      text-align: start;
    }
    .privacy-trust__item {
      align-items: flex-start;
    }
    /* Six across, one per signal. At 640-1023 this is two rows of three
       inside a 60ch column; with the block spanning the full 1200px there is
       room for the list to be a list. */
    .privacy-trust__signals {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .privacy-trust__signal {
      align-items: flex-start;
    }
  }
</style>
