---
import HamdamLogotype from './HamdamLogotype.astro';
import LanguageToggle from './LanguageToggle.astro';
import { APP_STORE, appStoreUrl } from '../lib/appStore';

interface Props {
  lang: 'en' | 'fa';
  /** True on the homepage, which opens on the dark hero sky: the
   * transparent nav needs cream text there. Every other route is cream
   * from y=0, so the transparent nav needs dark (indigo) text instead:
   * cream-on-cream is invisible (design-system.md §1 text-on-night is only
   * legible on a night/dusk surface). Once scrolled past the threshold the
   * backing is always solid night, so text is always cream from then on. */
  overDarkHero?: boolean;
  /** True only where overDarkHero depends on prefers-reduced-motion, i.e. the
   * two homepages. Emitted as an attribute so BaseLayout's script knows which
   * pages it may flip back to the light variant. */
  heroDarknessIsMotionDependent?: boolean;
}

const { lang, overDarkHero = false, heroDarknessIsMotionDependent = false } = Astro.props;
// Pre-release the bar carries no CTA at all (page spec §1 item 10); the
// coming-soon state lives in the hero only.
const ctaLabel = lang === 'fa' ? 'دریافت همدم' : 'Get Hamdam';
// No aria-label here, deliberately, since 2026-08-07. It used to read "Download
// Hamdam on the App Store" over visible text of "Get Hamdam", which fails WCAG
// 2.5.3 Label in Name: the accessible name has to contain the visible label, or
// a speech-input user saying "click Get Hamdam" hits nothing. Lighthouse
// flagged it as label-content-name-mismatch on every page.
//
// Removing the label rather than rewriting it, because the fix has to hold in
// both languages and this repo bars authoring the Persian half. The visible
// text is a perfectly good accessible name in both, and the href is an
// apps.apple.com URL, so nothing is lost. AppStoreBadge keeps its aria-label:
// its link contains an image and no visible text, so there is no name to
// conflict with.
---

<header
  data-nav-bar
  data-hero-motion-dependent={heroDarknessIsMotionDependent ? '' : undefined}
  class:list={['nav-bar fixed inset-x-0 top-0 z-40', !overDarkHero && 'nav-bar--on-light']}
>
  <div class="mx-auto flex h-14 max-w-[1200px] items-center justify-between px-5 sm:px-12">
    <a
      href={lang === 'fa' ? '/fa/' : '/'}
      class="inline-flex min-h-[44px] items-center"
      aria-label={lang === 'fa' ? 'همدم' : 'Hamdam'}
    >
      <HamdamLogotype lang={lang} size={24} />
    </a>
    <div class="flex items-center gap-3">
      <LanguageToggle lang={lang} inNav />
      {
        APP_STORE.RELEASED && (
          <a
            data-nav-cta
            href={appStoreUrl(lang, null, 'nav')}
            /* hidden below md (2026-08-14): StickyDownloadAction is the
               mobile CTA and is itself md:hidden, but this one carried no
               width condition, so on a phone both rendered at once --
               the same "Get Hamdam" pill in the bar and floating over the
               bottom of the same 844px viewport. stickyCta.js's whole
               premise is "exactly one App Store action is ever visible";
               the state machine was right and the markup was not. */
            class="nav-bar__cta hidden min-h-[44px] items-center rounded-[var(--radius-pill)] bg-[var(--hamdam-night-gold)] px-5 text-sm font-semibold text-indigo md:inline-flex"
          >
            {ctaLabel}
          </a>
        )
      }
    </div>
  </div>
</header>

<style>
  /* Transparent over the night sky at page top; solid night-surface backing
     with a hairline bottom border after 24px of scroll (page spec §1
     items 3, 7, 8). Text/logo colour is the on-night pair throughout: the
     bar is opaque once "solid", so its own contrast never depends on
     whatever section sits underneath it. */
  .nav-bar {
    background-color: transparent;
    border-bottom: 1px solid transparent;
    color: var(--text-on-night, #F4EDD8);
    transition:
      background-color 200ms var(--ease-dawn, ease),
      border-color 200ms var(--ease-dawn, ease),
      color 200ms var(--ease-dawn, ease);
  }
  /* Routes with no dark hero (privacy, terms, 404) are cream from y=0;
     cream nav text would be invisible until the solid backing lands. */
  .nav-bar--on-light {
    color: var(--color-indigo, #1B1B3A);
  }
  /* The bar wears the sky it is over (2026-08-14). It used to go solid
     --surface-night the moment you scrolled 24px and stay there, which was
     motivated for the 1350px of dark hero and unmotivated for the other
     11,000px: a hard navy slab pinned across a cream page for most of the
     scroll, and the single loudest thing on the site after the hero.

     --sky-color is already published on the root element by the shared
     scroll loop in BaseLayout, and the day arc's stops are positioned at the
     scroll offsets of the sections they belong to -- so at any scroll
     position it resolves to the colour of whatever is at the top of the
     viewport, which is exactly what is behind this bar. The bar is still
     fully opaque, so its own contrast never depends on what shows through;
     it just stops being a different colour from the page.

     Text tone follows the same signal rather than the scroll position, for
     the reason skyToneForProgress documents: the arc crosses light and dark
     four times, so nothing keyed to depth alone stays correct.

     The backing is never the raw sky, though: it is mixed 40% toward
     whichever end its text tone is. The bar is the one text-bearing element
     that crosses every stop, so while the sections were kept clear of the
     dead zone, the bar sailed straight through it -- a rendered-pixel audit
     caught the logotype and the language toggle on #765451 at 2.48:1 while
     the roots-to-dawn bridge passed underneath. Mixing toward night on the
     night tone and toward morning on the morning tone moves the backing off
     that range in whichever direction the text already is.

     60/40, not 70/30. At 70 the worst case across the ramp was still 4.49:1,
     under the floor by a hair, on the descent bridge at progress 0.460 where
     hysteresis deliberately holds the morning tone over a surface that has
     already gone dark. Sweeping the mix and re-measuring every stop in both
     scroll directions gives 6.31:1 on the night side and 5.44:1 on the
     morning side at 60. The bar still tracks the sky by a clear majority --
     it is a tint of the real colour, not a fixed slab -- it just never sits
     exactly on the one range where no text works. */
  .nav-bar[data-nav-solid] {
    background-color: color-mix(
      in srgb,
      var(--sky-color, var(--surface-night, #141430)) 60%,
      var(--surface-night, #141430)
    );
    border-bottom-color: rgb(244 237 216 / 0.12);
    color: var(--text-on-night, #F4EDD8);
  }
  :global(:root[data-sky-tone='morning']) .nav-bar[data-nav-solid] {
    background-color: color-mix(
      in srgb,
      var(--sky-color, var(--surface-morning, #F4EDD8)) 60%,
      var(--surface-morning, #F4EDD8)
    );
    color: var(--hamdam-text, #241E15);
    border-bottom-color: rgb(36 30 21 / 0.14);
  }
  .nav-bar__cta {
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms var(--ease-dawn, ease);
  }
  .nav-bar__cta[data-visible] {
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-bar,
    .nav-bar__cta {
      transition: none;
    }
  }
</style>
