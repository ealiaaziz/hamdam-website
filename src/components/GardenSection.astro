---
import { Image } from 'astro:assets';
import deviceFrame from '../assets/website-redesign/device-frame-iphone.png';
import gardenScreenshotEn from '../assets/website-redesign/screenshots/EN/07-garden-en.png';
import gardenPanelFa from '../assets/website-redesign/garden-panel-fa.png';
import { faCopy } from '../data/siteCopy';

// Added 2026-08-27. The Garden is the largest thing in version 1.3 and the
// site carried it as the third paragraph of a prose block -- present, correct,
// and invisible. Ealia's report was "I can't see anything about garden", which
// is a layout finding, not a copy one: the words were live, nothing showed
// them. That paragraph moves here and gets a picture.
//
// Every sentence below is Ealia's own, lifted from the 1.3 release notes he
// published on the App Store, and every claim in it is already VERIFIED in
// FACTS.md ("The Garden"): three coaches reading Health, the calendar and the
// weather; the habit bed and its on-the-day-it-does-not cue; the daily riddle.
// Nothing here is a new claim, which is the point -- the section needed a
// design, not an argument.
//
// Deliberately NOT claimed, though both are plainly visible in the screenshot:
// the "Today I am / Unwell, Injured, Travelling, On a deadline" chips, and
// anything about where the coaches' inputs go. The first is unrecorded in
// FACTS.md and a published screenshot is not the source FACTS.md asks for; the
// second would be a privacy claim, and WeatherKit does reach Apple, so the
// honest version of that sentence is longer than this section wants to be.

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;

// Farsi, added the same day the English section shipped. The copy is Ealia's
// own Persian, the half Apple publishes alongside the English release notes,
// split into fields by script rather than retyped -- see src/data/siteCopy.ts,
// which is where this repo keeps Persian it did not author.
//
// Farsi does not get the phone, and what it gets instead was Ealia's call on
// 2026-08-28. There is no Farsi capture of the Garden screen on iPhone: the
// listing's iPhone set is six English screens, the Farsi Today screen and the
// English Garden screen, and hamdam-ios/marketing's newest set is 2026-07-26
// and still says Discover. No macOS is reachable here to make one.
//
// The App Store product page carries a second set the lookup API does not
// return -- four iPad panels at 2048x2732 -- and one of them, `03-garden-fa`,
// is the Farsi Garden screen. That is the asset here, and it is a finished
// marketing composite rather than a screenshot: its own Persian caption, its
// own gradient, and a device that bleeds off the bottom edge, so there is no
// screen to lift out into the site's phone frame. It is used as a panel
// instead, which is why this component has two shapes of picture.
//
// Cropped to `left 247, top 505, 1553x2227`, which is the device plus a thin
// margin of its own gradient. Two reasons, and the first is the one that
// matters: an iPad screenshot carries about twice the interface in the same
// width as a phone, so at the 420px the uncropped composite needed, none of
// the Persian was readable and the panel was a dark rectangle. Cropped, the
// same 460px column shows گلستان, مربی‌های تو, باغچهٔ تو and بازی. The second
// is that his caption is headline-weight Persian and would have sat beside
// this section's own h2, two headlines arguing over one idea.
//
// It is an iPad, and for about an hour on 2026-08-28 that made it the only
// iPad on a site that said iPhone everywhere else. Ealia took the picture over
// no picture, and then closed the gap the other way: the site says "iPhone and
// iPad" throughout as of the same day, and `availableOnDevice` is
// `['iPhone', 'iPad']`. FACTS.md's platform entry carries the four legs of the
// evidence and the approved Farsi.
const copy =
  lang === 'fa'
    ? {
        eyebrow: faCopy.garden.eyebrow,
        heading: faCopy.garden.heading,
        body: faCopy.garden.body,
        items: faCopy.garden.items,
      }
    : {
        eyebrow: 'The Garden',
        heading: 'Nothing is asked of you that the day cannot carry.',
        body: 'Three coaches, Mind, Move and Sleep, turn today’s one line into a plan for the whole day, reading from your Health data, your calendar and the weather.',
        items: [
          {
            title: 'A garden bed for habits',
            body: 'Plant one small thing, say when it happens and what you will do on the day it does not, then watch it grow on every day you tend it.',
          },
          {
            title: 'A riddle each morning',
            body: 'A new one waits every day, beside the verse you already came for.',
          },
        ],
      };

// The picture and its description travel together, so the branch with an image
// is also the branch that describes it. `kind` is what the template switches
// on: 'device' composites a screenshot behind the iPhone frame's cutout,
// 'panel' renders a finished composite whole.
//
// The Farsi alt is the one word Ealia's own published text supplies for this
// screen. The panel's baked-in caption would be a better description, but it
// exists only as pixels, and transcribing Persian out of an image is exactly
// the authoring this repo does not do.
const shot =
  lang === 'fa'
    ? { kind: 'panel', src: gardenPanelFa, alt: faCopy.garden.eyebrow }
    : {
        kind: 'device',
        src: gardenScreenshotEn,
        alt: 'The Hamdam Garden screen: a gentler start for the day, and the Mind, Move and Sleep coaches.',
      };

// Same cutout geometry as the hero and JourneyPair -- measured from the
// frame's own alpha channel, not eyeballed. See HeroCinematic.astro.
const FRAME_DISPLAY_WIDTH = 480;
const FRAME_DISPLAY_HEIGHT = Math.round((FRAME_DISPLAY_WIDTH / deviceFrame.width) * deviceFrame.height);

// The panel is wider on the page than the phone is (3:4 against 1290:2796) and
// never exceeds 420px CSS, so 840px is its 2x budget.
const PANEL_DISPLAY_WIDTH = 840;
---

<section class:list={['garden', `garden--${shot.kind}`]} aria-labelledby="garden-title">
  <div class="garden__inner">
    {
      shot.kind === 'device' ? (
        <div class="garden__frame" role="img" aria-label={shot.alt}>
          <Image
            src={shot.src}
            alt=""
            width={630}
            height={1366}
            quality={80}
            class="garden__frame-screen"
          />
          <Image
            src={deviceFrame}
            alt=""
            width={FRAME_DISPLAY_WIDTH}
            height={FRAME_DISPLAY_HEIGHT}
            quality={72}
            class="garden__frame-img"
          />
        </div>
      ) : (
        <Image
          src={shot.src}
          alt={shot.alt}
          width={PANEL_DISPLAY_WIDTH}
          height={Math.round((PANEL_DISPLAY_WIDTH / shot.src.width) * shot.src.height)}
          quality={78}
          class="garden__panel"
        />
      )
    }

    <div class="garden__copy" data-reveal>
      <p class="garden__eyebrow">{copy.eyebrow}</p>
      <h2 id="garden-title" class="garden__heading text-balance">
        {copy.heading}
      </h2>
      <p class="garden__body">{copy.body}</p>

      <ul class="garden__items">
        {copy.items.map((item) => (
          <li class="garden__item">
            <h3 class="garden__item-title">{item.title}</h3>
            <p class="garden__item-body">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Day arc, afternoon into late day. This section takes over the step the
     `afternoon-lateday` SectionDivider used to make on its own: the divider
     existed because nothing else crossed that gap, and a section that crosses
     it is a better bridge than 220px of empty gradient. Both stops are warm
     mid-tones where only --hamdam-text clears 4.5:1 (afternoon 8.37:1), so
     every colour below is that token or a translucent cream panel -- no
     --hamdam-text-soft, no opacity steps. See tokens.css. */
  .garden {
    padding-block: var(--spacing-section-mobile);
    padding-inline: 1.5rem;
    background: linear-gradient(to bottom, var(--arc-afternoon), var(--arc-lateday));
    color: var(--hamdam-text);
  }
  @media (min-width: 640px) {
    .garden {
      padding-block: var(--spacing-section-desktop);
    }
  }

  .garden__inner {
    max-width: 1200px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .garden__frame {
    position: relative;
    flex-shrink: 0;
    width: min(260px, 64vw);
    aspect-ratio: 1290 / 2796;
    border-radius: var(--radius-device);
    background: linear-gradient(to bottom, var(--surface-dusk), var(--surface-firstlight));
    box-shadow: var(--shadow-rest);
    overflow: hidden;
  }

  .garden__frame-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Explicit width/height rather than four insets: an absolutely positioned
     replaced element with all four insets and auto sizing is over-constrained
     and browsers fall back to the intrinsic size, so the insets silently do
     nothing. Confirmed live once already -- see JourneyPair.astro. */
  .garden__frame-screen {
    position: absolute;
    top: 5.97%;
    left: 6.43%;
    width: 87.5%;
    height: 87.62%;
    object-fit: cover;
    border-radius: 8%;
  }

  .garden__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .garden__heading {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: 600;
  }
  :global([lang='fa']) .garden__heading {
    font-family: var(--font-farsi);
    font-weight: 500;
  }

  .garden__body {
    margin-top: 1.25rem;
    max-width: 40rem;
    font-size: var(--text-body);
    line-height: 1.7;
  }
  :global([lang='fa']) .garden__body,
  :global([lang='fa']) .garden__item-body {
    line-height: 1.9;
  }

  /* The Farsi eyebrow is a word, not a label: uppercase does nothing to
     Persian and the wide tracking pulls the letters out of their joins, so
     both come off and the size carries the role instead. */
  :global([lang='fa']) .garden__eyebrow {
    font-family: var(--font-farsi);
    letter-spacing: normal;
    text-transform: none;
  }

  .garden__items {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .garden__item {
    border-radius: var(--radius-panel);
    padding: 1.5rem;
    background: rgb(244 237 216 / 0.42);
    border: 1px solid rgb(36 30 21 / 0.12);
  }

  .garden__item-title {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 600;
  }
  :global([lang='fa']) .garden__item-title {
    font-family: var(--font-farsi);
  }

  .garden__item-body {
    margin-top: 0.5rem;
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* The panel (Farsi) is a finished composite with its own gradient behind it,
     so it needs an edge of its own or it reads as a rectangle pasted onto the
     arc. Rounded to the same radius as the section's cards and given the same
     resting shadow the device frame carries, it reads as one more object on
     the surface. No border: the composite's own gradient is close enough to
     afternoon that a line would be the only hard edge in the section. */
  .garden__panel {
    flex-shrink: 0;
    width: min(380px, 78vw);
    height: auto;
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-rest);
  }

  /* Frame first in the source order and first in the row, so the page
     alternates: JourneyPair above puts its copy on the leading side and its
     phones on the trailing one. `row` (not row-reverse) means RTL mirrors this
     for free if a Farsi capture ever arrives. */
  @media (min-width: 900px) {
    .garden__inner {
      flex-direction: row;
      align-items: center;
      gap: 4rem;
    }
    .garden__frame {
      width: min(300px, 30vw);
    }
    /* Wider than the phone at the same height, since 3:4 next to 1290:2796 at
       equal width would tower over the copy. */
    .garden__panel {
      width: min(460px, 36vw);
    }
    .garden__copy {
      flex: 1 1 auto;
    }
    .garden__items {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
