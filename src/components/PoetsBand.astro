---
import PoetCard from './PoetCard.astro';
import { poets } from '../data/poets';
import { POET_PAGES } from '../data/poetPages';

// Looked up by poetIndex rather than by position. POET_PAGES happens to be in
// the same order as `poets` today, and indexing by i would silently point
// every card at the wrong poet the first time either array is reordered.
const pageForPoet = new Map(POET_PAGES.map((p) => [p.poetIndex, p]));
const hrefForPoet = (i: number, lang: 'en' | 'fa') => {
  const page = pageForPoet.get(i);
  if (!page) return null;
  return lang === 'fa' ? `/fa/poets/${page.slug}/` : `/poets/${page.slug}/`;
};

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;

const heading = lang === 'fa' ? 'پنج شاعر، پنج صدا.' : 'Five poets, five voices.';
const provenance =
  lang === 'fa'
    ? 'شعرها از گنجور گردآوری شده‌اند. پرتره‌ها برداشت‌های هنری هستند.'
    : 'Verses sourced from Ganjoor.net. Portraits are artistic interpretations.';
const carouselLabel = lang === 'fa' ? 'پنج شاعر' : 'The five poets';
---

<section class="poets-band" aria-labelledby="poets-band-title">
  <h2 id="poets-band-title" class="poets-band__heading text-balance">{heading}</h2>

  {
    /* Native horizontal scroll (no JS): scroll-snap on mobile, unwrapped
       row on desktop via min-width media query below. tabindex makes the
       scroller itself keyboard-reachable/arrow-scrollable (page spec §4
       item 11) since the cards carry no click action of their own
       (item 10: "no conversion action, this section builds authority"). */
  }
  <div
    class="poets-band__track"
    role="region"
    aria-label={carouselLabel}
    tabindex="0"
    data-reveal-group
  >
    {poets.map((poet, i) => (
      <PoetCard
        lang={lang}
        persianName={poet.persianName}
        transliteration={poet.transliteration}
        description={lang === 'fa' ? poet.descriptionFa : poet.description}
        portrait={poet.portrait}
        emphasized={i === 2}
        href={hrefForPoet(i, lang)}
      />
    ))}
  </div>

  <div class="poets-band__dots" aria-hidden="true">
    {poets.map(() => <span class="poets-band__dot" />)}
  </div>

  <p class="poets-band__provenance">{provenance}</p>
</section>

<style>
  /* The trough of the day arc, and the only section that stays a flat field:
     both bridges either side of it land on this exact colour, so the poets
     sit in a held moment of evening rather than on a slope. Same #2A2140 as
     before, named through the arc now. */
  .poets-band {
    padding-block: var(--spacing-section-mobile);
    background-color: var(--arc-dusk);
    color: var(--text-on-night);
  }
  @media (min-width: 640px) {
    .poets-band {
      padding-block: var(--spacing-section-desktop);
    }
  }

  .poets-band__heading {
    text-align: center;
    padding-inline: 1.5rem;
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: 600;
  }
  :global([lang='fa']) .poets-band__heading {
    font-family: var(--font-farsi);
    font-weight: 500;
  }

  /* Fixed 2026-08-14: Parvin was unreachable between 1024px and ~1360px.
     The old rule flipped the track to `overflow-x: visible` at min-width
     1024px, but the row is four 240px cards plus one 272px card and four
     20px gaps -- 1312px, plus 48px of padding. So from 1024px up to 1360px
     the fifth card sat outside the viewport with the scroller switched off
     and no way to reach it. The document reported scrollWidth 1168 at a
     1024 viewport while the page itself could not be scrolled sideways.
     `34-next-steps.md` recorded this as "worth a glance, not a defect"; it
     cost the section a poet at every laptop width.

     `safe center` is the fix rather than a higher breakpoint: the track
     always scrolls, and centring only applies while the content fits, so
     there is no width at which a card is both off-screen and unreachable.
     Plain `center` would not do -- it centres overflow in both directions
     and makes the first card unreachable instead of the last. */
  .poets-band__track {
    margin-top: 2.5rem;
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    justify-content: safe center;
    align-items: flex-start;
    padding-inline: 1.5rem;
    padding-block-end: 0.5rem;
  }
  .poets-band__track:focus-visible {
    outline: 2px solid var(--hamdam-night-gold);
    outline-offset: 4px;
  }

  .poets-band__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .poets-band__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-on-night-muted);
  }
  /* 1400px, not 1024px: the dots say "this scrolls", and it still does at
     1024 (see the track comment). Hiding them where the row is in fact
     still scrollable removed the only affordance telling anyone the fifth
     poet was there. */
  @media (min-width: 1400px) {
    .poets-band__dots {
      display: none;
    }
  }

  .poets-band__provenance {
    margin-top: 2rem;
    text-align: center;
    padding-inline: 1.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    color: var(--text-on-night-muted);
  }
</style>
