---
interface Props {
  persian: string;
  translation: string;
  poet: string;
  class?: string;
}

const { persian, translation, poet, class: className = '' } = Astro.props;
---

<figure
  data-reveal
  class:list={[
    /* Equal heights kept; `grow` on the blockquote removed (2026-08-14).
       The defect was never that the cards matched heights -- three cards in
       a row should be one rectangle each. It was that `grow` pushed the
       translation and the attribution down to the card's bottom edge, so a
       short verse put 300px of blank card between the Persian and the
       English that explains it, and the reader had to cross the gap to
       connect two halves of one thought. Without it the content flows from
       the top and the slack collects at the foot of the card, where it is
       just margin. Verified both ways in the browser: dropping h-full as
       well makes it worse, because one long verse in the set leaves the
       other two floating in a ragged void.

       backdrop-blur went with the translucency -- --color-card is opaque
       now, so it was compositing work for an effect nothing could see. */
    'flex h-full flex-col rounded-[var(--radius-card)] bg-card p-6 sm:p-8 shadow-card',
    className,
  ]}
>
  <blockquote lang="fa" dir="rtl">
    <p class="font-farsi-verse text-[length:var(--text-verse-fa)] font-medium leading-[1.9] text-start text-indigo whitespace-pre-line [text-wrap:pretty]">
      {persian}
    </p>
  </blockquote>
  <p lang="en" dir="ltr" class="mt-6 font-serif italic leading-[1.7] text-[var(--hamdam-text-soft)]">
    {translation}
  </p>
  <figcaption class="mt-6">
    <cite class="text-sm font-medium not-italic tracking-[0.08em] text-saffron-ink [font-variant:small-caps]">
      {poet}
    </cite>
  </figcaption>
</figure>
