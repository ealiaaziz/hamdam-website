---
import { Image } from 'astro:assets';
import PersianShamseh from './PersianShamseh.astro';
import AppStoreBadge from './AppStoreBadge.astro';
import { starField } from '../lib/cinematic';
import heroHorizonDesktop from '../assets/website-redesign/hero-horizon-desktop.png';
import heroHorizonMobile from '../assets/website-redesign/hero-horizon-mobile.png';
import heroBlossomForeground from '../assets/website-redesign/hero-blossom-foreground.png';
import deviceFrame from '../assets/website-redesign/device-frame-iphone.png';
import heroScreenshotEn from '../assets/website-redesign/screenshots/EN/01-today-en.png';
import heroScreenshotFa from '../assets/website-redesign/screenshots/FA/01-today-fa.png';

interface Props {
  lang: 'en' | 'fa';
  title: string;
  subhead: string;
}

const { lang, title, subhead } = Astro.props;
// Deterministic star field (seed 42 by spec), rendered at build time so the
// client never computes positions and they can never jitter.
const stars = starField(40, 42);

// Replaced 2026-08-16. This was `01-hero-en/fa.png`, described here as a real
// orchestrator screenshot of the Today screen seeded with the hafez-015 verse.
// It was a real render, and it was not a real screen. It came from
// `TodayScreenshotView` in hamdam-ios's DebugTools/ScreenshotOrchestrator: a
// `#if DEBUG` composition that never calls TodayView and whose verse card
// (`ScreenshotViewFactory.swift:406-422`) carries no language check, so it
// stacked Persian over English in both locales. The Farsi one was the worse
// half: the app in Farsi deliberately shows no English at all (Ealia,
// 2026-07-27). Four of its six elements are absent from production Today --
// the Persian couplet in EN mode, both languages together, the streak pill
// (removed 2026-07-23) and the Apple Health row (a different tab).
//
// The harness header calls its previews "assembled entirely from real, shared
// production components ... never a hand-drawn mock", which is true of the
// components and false of the arrangement. That sentence is why this survived
// three weeks on the homepage.
//
// `01-today-en/fa.png` is the 2026-07-26 capture of the real Today screen,
// 1320x2868, matched EN/FA pair, verified against the production view. It has
// no verse on it, and no screenshot in that repo is both a real app screen and
// a screen with a verse: the fal shows one only after you tap "Receive Verse".
// The poetry claim now lives entirely in the h1 and the copy, which can carry
// it honestly, rather than in a picture that could not. See FACTS.md, "The
// homepage hero screenshot", for the full record.
const heroScreenshot = lang === 'fa' ? heroScreenshotFa : heroScreenshotEn;
// The Farsi alt lost "با شعری صبحگاهی از حافظ" (with a morning verse by Hafez)
// and gained nothing: deletion only, because the replacement image has no verse
// and this repo bars authoring Persian. Every remaining character is from the
// approved string.
const deviceAlt =
  lang === 'fa'
    ? 'نمای صفحه اصلی همدم'
    : 'The Hamdam Today screen: an evening greeting, the sky where you live, and the day’s reflection.';
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero__viewport">
    <div class="hero__sky" aria-hidden="true">
      <svg
        class="hero__stars"
        viewBox="0 0 1000 650"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        {stars.map((s) => (
          <circle cx={s.x * 10} cy={s.y * 10} r={s.r * 1.6} fill="#F5EEE0" opacity={s.o} />
        ))}
      </svg>
      {
        /* Real WebGL depth layer, added 2026-07-20 (Ealia's explicit override of the
           redesign's original no-WebGL hero decision, see
           docs/website-redesign/22-dependency-decision.md). Sits over the SVG field above;
           once three.js initialises successfully the script below fades the SVG field to 0
           and drives this canvas instead, so a WebGL failure of any kind just leaves the
           original flat field visible, never a gap. */
      }
      <canvas class="hero__scene3d" aria-hidden="true"></canvas>
      <div class="hero__sun-track" aria-hidden="true">
        <div class="hero__sun"></div>
      </div>
      {
        /* HW-01/HW-02 (14-canva-asset-brief.md): photographic horizon plate,
           desktop vs mobile recomposition, swapped by CSS breakpoint (768px,
           this repo's md breakpoint per StickyDownloadAction.astro's own
           convention). Each asset's own alpha channel already carries the
           top-fade-to-transparent gradient the brief requires, so no extra
           masking is needed here -- just placement and the existing
           scroll-linked drift. Flipped under RTL per the brief's own
           acceptance criterion ("mirrors cleanly when flipped horizontally
           for RTL"). .hero__horizon (the ambient haze band) is kept
           unchanged underneath as a separate atmospheric layer, not
           replaced -- it is not a stand-in for the photo, see its own
           comment below. */
      }
      <Image
        src={heroHorizonDesktop}
        alt=""
        width={heroHorizonDesktop.width}
        height={heroHorizonDesktop.height}
        loading="eager"
        fetchpriority="high"
        class="hero__horizon-photo hero__horizon-photo--desktop"
      />
      <Image
        src={heroHorizonMobile}
        alt=""
        width={heroHorizonMobile.width}
        height={heroHorizonMobile.height}
        loading="eager"
        fetchpriority="high"
        class="hero__horizon-photo hero__horizon-photo--mobile"
      />
      {
        /* HW-04: desktop-only foreground blossom plate. Dropped on mobile
           per the page spec -- there is no HW-04 mobile variant, this is
           not an oversight. Real alpha edges (no halo), so no additional
           masking needed. */
      }
      <Image
        src={heroBlossomForeground}
        alt=""
        width={heroBlossomForeground.width}
        height={heroBlossomForeground.height}
        class="hero__blossom-photo"
      />
      {
        /* Ambient haze band (predates the redesign, no asset dependency --
           see the original TODO this replaced, now resolved above). */
      }
      <div class="hero__horizon"></div>
    </div>

    <div class="hero__content">
      <div class="hero__copy">
        <PersianShamseh size={64} color="currentColor" class="hero__mark" />
        <h1 id="hero-title" class="hero__title text-balance">{title}</h1>
        <p class="hero__sub text-balance">{subhead}</p>
        <div class="hero__cta" data-store-cta="hero">
          <AppStoreBadge lang={lang} placement="hero" />
        </div>
      </div>

      {
        /* Real orchestrator screenshot composited 2026-07-19 behind the
           frame, through its transparent screen cutout (per the frame's
           own brief, 14-canva-asset-brief.md). Cutout position measured
           directly from device-frame-iphone.png's alpha channel (connected
           transparent region from centre: left 6.43%, top 5.97%, right
           6.07%, bottom 6.41% of the frame's own box) -- not eyeballed,
           and reused identically by every other DV-01 consumer since they
           all share the same 1290/2796 container aspect-ratio and
           object-fit: contain frame rendering. Verified by local
           composite render before wiring (grey-canvas standin, no live
           browser available this session) -- single clean device mockup,
           no double-framing, background full-bleed. */
      }
      <div class="hero__device" role="img" aria-label={deviceAlt}>
        <Image
          src={heroScreenshot}
          alt=""
          width={945}
          height={2052}
          quality={80}
          class="hero__device-screen"
        />
        {
          /* On-page display never exceeds 360px CSS width (.hero__device's
             own max), so 720px (2x retina headroom) is the real budget-
             relevant output size -- the full 1400x2820 source stays intact
             on disk per the brief's exact-dimensions requirement, only the
             on-page render is scaled down, same "compression owner:
             implementation session" split the brief specifies for every
             asset. */
        }
        <Image
          src={deviceFrame}
          alt=""
          width={600}
          height={Math.round((600 / deviceFrame.width) * deviceFrame.height)}
          quality={72}
          class="hero__device-frame"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Phase 3 defaults (unchanged): first-light, matching what reduced-motion
    visitors see permanently (page spec §2 item 8). Phase 4's script
    overrides these via inline custom properties for motion-OK visitors,
    starting from night and brightening across the first viewport of
    scroll; reduced-motion visitors keep these exact defaults except for
    instant (non-interpolated) threshold jumps -- see the script below.
  */
  .hero {
    /* Own stacking context: without this, .hero__sky's z-index: -1 (and
       its position: absolute, lacking a positioned ancestor otherwise)
       compares against the ROOT stacking context instead of staying
       scoped to the hero -- exactly the bug that let the page-level
       SkySurface (Phase 4) bleed through unpredictably. */
    position: relative;
    isolation: isolate;
    /* 150vh, not 200vh (2026-07-25): the hero used to hold the page for a full
       viewport of scroll before any content, which is most of why the page did
       not say what the app does fast enough. Half a viewport of sticky travel
       is enough for the sunrise to read, and the script below now derives its
       progress from this element's own travel rather than assuming one
       viewport, so changing this number retimes the arc instead of truncating
       it. A literal 100vh would delete the sunrise, which the brief keeps. */
    height: 150vh;
    --sky-top: #E8B04B;
    --sky-bot: #F5EEE0;
    --sun-y: -10%;
    --sun-glow: 24px;
    --stars-o: 0;
    --haze-o: 0.12;
    --hero-text: var(--hamdam-text);
    --title-shadow-o: 0;
    --scrim-o: 0;
    --horizon-drift: 0px;
    --device-drift: 0px;
  }

  .hero__viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: 6.5rem 2rem;
    padding-inline: 1.5rem;
  }

  .hero__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, var(--sky-top), var(--sky-bot));
  }

  .hero__stars {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    width: 100%;
    height: 65%;
    opacity: var(--stars-o);
  }

  .hero__scene3d {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    width: 100%;
    height: 65%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms var(--ease-cross, ease);
  }
  .hero--scene3d-active .hero__scene3d {
    opacity: 1;
  }
  .hero--scene3d-active .hero__stars {
    opacity: 0;
  }

  .hero__sun-track {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 76%;
    overflow: hidden;
  }

  .hero__sun {
    position: absolute;
    bottom: 0;
    inset-inline-start: 10%;
    width: clamp(72px, 9vw, 112px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, var(--hamdam-saffron), var(--hamdam-ember) 78%);
    box-shadow: 0 0 var(--sun-glow) rgb(232 176 75 / 0.5);
    transform: translateY(var(--sun-y));
  }

  /* The haze has its own drift rate (2026-08-15). It shared --horizon-drift
     with the photographic mountain plate below, so two layers that are
     nowhere near each other in the scene settled by the identical distance
     and read as one flat plate. --haze-drift is a little over half the
     mountains' rate, which is the right direction: atmospheric haze sits
     further away than the ridgeline in front of it, and further things move
     less. Both still resolve to 0 at the end of the hero, so nothing about
     the final composition changes -- only the way it assembles. */
  .hero__horizon {
    position: absolute;
    top: 70%;
    inset-inline: 0;
    height: 14%;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--hamdam-mist-amber-grey) 45%,
      transparent
    );
    opacity: var(--haze-o);
    transform: translateY(var(--haze-drift, var(--horizon-drift)));
  }

  .hero__horizon-photo {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    transform: translateY(var(--horizon-drift));
  }
  :global([dir='rtl']) .hero__horizon-photo {
    transform: scaleX(-1) translateY(var(--horizon-drift));
  }

  .hero__horizon-photo--desktop {
    display: none;
  }
  .hero__horizon-photo--mobile {
    display: block;
  }
  @media (min-width: 768px) {
    .hero__horizon-photo--desktop {
      display: block;
    }
    .hero__horizon-photo--mobile {
      display: none;
    }
  }

  .hero__blossom-photo {
    display: none;
  }
  @media (min-width: 768px) {
    .hero__blossom-photo {
      display: block;
      position: absolute;
      inset-inline-start: 0;
      bottom: 0;
      width: min(32%, 420px);
      height: auto;
      transform: translateY(calc(var(--horizon-drift) * 1.5));
    }
    :global([dir='rtl']) .hero__blossom-photo {
      transform: scaleX(-1) translateY(calc(var(--horizon-drift) * 1.5));
    }
  }

  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 800px;
    color: var(--hero-text);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Desktop: copy and device side by side, so the sentence saying what the app
     does, the badge and the phone are all above the fold together rather than
     the device sitting a scroll below the CTA. */
  @media (min-width: 900px) {
    .hero__content {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 4rem;
      max-width: 1100px;
      text-align: start;
    }
    .hero__copy {
      align-items: flex-start;
      flex: 1 1 0;
      max-width: 34rem;
    }
    /* One notch down from --text-display: at this column width the full-size
       display type ran to five lines and pushed the badge toward the fold. */
    .hero__title {
      font-size: clamp(2.75rem, 3.4vw, 3.75rem);
    }
    :global([dir='rtl']) .hero__copy {
      align-items: flex-end;
    }
  }

  .hero__title {
    margin-top: 2.5rem;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-display);
    line-height: 1.05;
  }

  :global([lang='fa']) .hero__title {
    font-family: var(--font-farsi);
    font-weight: 500;
    font-size: var(--text-display-fa);
    line-height: 1.25;
  }

  .hero__sub {
    margin-top: 2rem;
    max-width: 36rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.7;
    opacity: 0.9;
  }

  :global([lang='fa']) .hero__sub {
    font-family: var(--font-farsi);
    font-style: normal;
    line-height: 1.9;
  }

  .hero__cta {
    margin-top: 3rem;
  }

  .hero__device {
    position: relative;
    margin-top: 3rem;
    width: min(260px, 62vw);
    aspect-ratio: 1290 / 2796;
    border-radius: var(--radius-device);
    background: linear-gradient(to bottom, var(--surface-dusk), var(--surface-firstlight));
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    /* The independent `translate` property, not transform (2026-08-15). This
       drift had never applied to anyone: the hero-settle animation below runs
       on this element with `forwards` and ends at `transform: translateY(0)`,
       and an animation's value beats the element's own transform declaration
       and keeps beating it after the animation finishes. So every motion-OK
       visitor got translateY(0) instead of the drift, and reduced-motion
       visitors never run the script that defines --device-drift at all, which
       made the declaration invalid. Three planes were drifting and the fourth
       was pinned.

       `translate` is a separate property from `transform` and composes with it
       (translate, then rotate, then scale, then transform), so the settle
       animation and the rotation can own `transform` while the scroll-linked
       drift owns this. Nothing has to be sequenced or duplicated into
       keyframes, and the value keeps re-resolving as the scroll updates it.

       The 0px fallback matters: reduced-motion visitors never get the custom
       property defined, and without it the declaration would be invalid rather
       than simply zero. */
    translate: 0 var(--device-drift, 0px);
  }

  /* The hero phone sits in space at desktop (2026-08-15), matching the paired
     frames in JourneyPair so the site has one depth language rather than a flat
     device here and angled ones further down.

     This has to be done through the settle keyframes rather than as a static
     `transform` on .hero__device, and finding out why turned up something
     pre-existing. The hero-settle animation below runs on .hero__device with
     `forwards`, and its final keyframe is `transform: translateY(0)` -- an
     animation's value wins over the element's own transform declaration, and
     `forwards` keeps it winning after the animation ends. So the element's
     `transform: translateY(var(--device-drift))` has never applied for anyone:
     motion-OK visitors get the animation's translateY(0) instead, and
     reduced-motion visitors never run the script that defines --device-drift,
     which makes the declaration invalid. Setting a static rotateY here would
     have been clobbered in exactly the same way and looked like a CSS bug.
     --device-drift being dead is a separate, older issue and is left alone
     here rather than fixed as a side effect of a 3D change.

     perspective() as a transform function rather than a property on a parent:
     the device is the only thing in that stack that wants depth, and the
     property on the parent would put the headline and CTA beside it into the
     same 3D context.

     Desktop only. Below 1024px the device is centred under the copy rather than
     beside it, and turning a device that already faces the reader only turns it
     away. Reduced-motion needs no override: these keyframes live in the
     no-preference block, so that branch keeps the flat element. */
  /* Both selectors are direction-qualified, and the LTR one has to be. The
     settle block further down uses the `animation:` shorthand, which resets
     animation-name, and it comes later in the source -- so a bare
     `.hero__device` here loses to it at equal specificity while the RTL
     selector wins on its extra attribute. That asymmetry is worse than either
     outcome on its own: it shipped a rotated device in Farsi and a flat one in
     English from the same rule. Matching the specificity on both sides keeps
     the two directions honest with each other. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    :global([dir='ltr']) .hero__device {
      animation-name: hero-settle-device;
    }
    /* The hero mirrors under RTL, so the device lands on the other side of the
       copy and has to turn the other way to face it. */
    :global([dir='rtl']) .hero__device {
      animation-name: hero-settle-device-rtl;
    }
  }

  /* Same 12px rise and fade as hero-settle, landing rotated instead of flat. */
  @keyframes hero-settle-device {
    from { opacity: 0; transform: perspective(1600px) translateY(12px) rotateY(-7deg); }
    to { opacity: 1; transform: perspective(1600px) translateY(0) rotateY(-7deg); }
  }
  @keyframes hero-settle-device-rtl {
    from { opacity: 0; transform: perspective(1600px) translateY(12px) rotateY(7deg); }
    to { opacity: 1; transform: perspective(1600px) translateY(0) rotateY(7deg); }
  }

  .hero__device-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero__device-screen {
    /* Explicit width/height, not auto + all four insets -- see
       JourneyPair.astro's .journey__frame-screen comment for why (replaced-
       element over-constraint bug, confirmed live: insets were silently
       not shrinking the image at all). */
    position: absolute;
    top: 5.97%;
    left: 6.43%;
    width: 87.5%;
    height: 87.62%;
    object-fit: cover;
    border-radius: 8%;
  }

  @media (min-width: 640px) {
    .hero__device {
      width: min(360px, 32vw);
    }
  }
  @media (min-width: 900px) {
    .hero__device {
      margin-top: 0;
      flex: 0 0 auto;
      /* Sized to clear the viewport's own padding at the shortest laptop height
         we support, so the phone is never cropped by the fold it is meant to
         sit above. */
      width: min(300px, 26vw);
    }
  }

  .hero--in-view .hero__sun,
  .hero--in-view .hero__stars {
    will-change: transform, opacity;
  }

  /* One-time settle-in on load (motion-specification.md §3): mark, title,
     sub, CTA, device rise 12px and fade in, staggered 80ms, 600ms total.
     Motion-OK only; reduced-motion renders the final state immediately
     (no keyframes run at all, so "no settle-in" is exact, not just fast). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__mark,
    .hero__title,
    .hero__sub,
    .hero__cta,
    .hero__device {
      opacity: 0;
      animation: hero-settle 600ms var(--ease-settle) forwards;
    }
    .hero__mark { animation-delay: 0ms; }
    .hero__title { animation-delay: 80ms; }
    .hero__sub { animation-delay: 160ms; }
    .hero__cta { animation-delay: 240ms; }
    .hero__device { animation-delay: 320ms; }
  }

  /* ?dawn=N design-review mode: timeline pinned, entrance pre-settled so
     screenshots are deterministic. */
  .hero--settled .hero__mark,
  .hero--settled .hero__title,
  .hero--settled .hero__sub,
  .hero--settled .hero__cta,
  .hero--settled .hero__device {
    animation: none;
    opacity: 1;
    transform: none;
  }

  @keyframes hero-settle {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import {
    gradientForProgress,
    sunYForProgress,
    sunGlowForProgress,
    starsOpacityForProgress,
    hazeOpacityForProgress,
    textColorForProgress,
    titleShadowOpacityForProgress,
    scrimOpacityForProgress,
    prefersReducedMotion,
  } from '../lib/cinematic';
  import { initHeroScene3d } from '../lib/heroScene3d';

  const hero = document.getElementById('hero');

  // Reduced motion: this script does not run at all. Phase 3's static CSS
  // defaults on .hero already ARE the exact first-light state ("warm,
  // legible, complete", page spec §2 item 8) -- not a low-progress point
  // on this continuous ramp, which is still quite dark until well past
  // p=0.5. Leaving those defaults completely untouched is simpler and more
  // correct than trying to reproduce "first-light" by quantizing progress.
  if (hero && !prefersReducedMotion()) {
    const style = hero.style;
    const navBar = document.querySelector<HTMLElement>('[data-nav-bar]');
    // textColorForProgress returns lerpHex output ("rgb(r g b)"), never a
    // raw hex string -- this must match that exact format.
    const DARK_TEXT = 'rgb(36 30 21)';

    // WebGL depth layer: dynamic-imported inside initHeroScene3d, so its chunk is
    // never fetched here for reduced-motion visitors (this whole branch already
    // excludes them). If it fails for any reason (no WebGL, context creation
    // failure, blocked GPU), scene3d stays null and the existing flat SVG star
    // field (already in the markup, already driven by --stars-o below) is simply
    // never hidden -- no fallback branching needed at the call site.
    let lastProgress = 0;
    let scene3d = null;
    const canvas = hero.querySelector<HTMLCanvasElement>('.hero__scene3d');
    if (canvas) {
      // Deferred to idle, 2026-08-07. Creating the GL context and compiling the
      // shaders is a one-off cost, but it landed inside the load window and
      // showed up as run-to-run swings in Total Blocking Time (445ms on a cold
      // run against 13ms on a warm one). Nothing above the fold depends on it:
      // the flat SVG star field is already painted and stays until this
      // resolves, so waiting for the main thread to be free costs the visitor
      // nothing and takes the work off the critical path.
      //
      // The 1500ms timeout is the ceiling, not the target, and the setTimeout
      // is for Safari, which still has no requestIdleCallback.
      const startScene3d = () => {
        initHeroScene3d(canvas).then((controller) => {
          if (!controller) return;
          scene3d = controller;
          hero.classList.add('hero--scene3d-active');
          scene3d.setProgress(lastProgress);
        });
      };
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(startScene3d, { timeout: 1500 });
      } else {
        setTimeout(startScene3d, 300);
      }
    }

    const apply = (p) => {
      lastProgress = p;
      scene3d?.setProgress(p);
      const g = gradientForProgress(p);
      style.setProperty('--sky-top', g.top);
      style.setProperty('--sky-bot', g.bot);
      style.setProperty('--sun-y', `${sunYForProgress(p)}%`);
      style.setProperty('--sun-glow', `${sunGlowForProgress(p)}px`);
      style.setProperty('--stars-o', String(starsOpacityForProgress(p)));
      style.setProperty('--haze-o', String(hazeOpacityForProgress(p)));
      const heroText = textColorForProgress(p);
      style.setProperty('--hero-text', heroText);
      style.setProperty('--title-shadow-o', String(titleShadowOpacityForProgress(p)));
      style.setProperty('--scrim-o', String(scrimOpacityForProgress(p)));

      // Depth-cueing drift (motion-specification.md §3): horizon at 8% of
      // the hero's own 0-to-1-viewport scroll range; device settles over
      // the last 24px of its rise.
      const vh = window.innerHeight;
      style.setProperty('--horizon-drift', `${(1 - p) * 0.08 * vh}px`);
      // A third settle rate, so the hero assembles from four planes rather
      // than three: sky, haze, mountains, device. The haze is behind the
      // ridgeline, so it travels less than the 0.08 the mountain plate uses.
      style.setProperty('--haze-drift', `${(1 - p) * 0.045 * vh}px`);
      style.setProperty('--device-drift', `${(1 - p) * 24}px`);

      // Nav text tracks the same flip as the hero's own text (transparent
      // over whatever the hero currently shows behind it): dark ink once
      // the sky is light enough to hold it, cream otherwise.
      navBar?.classList.toggle('nav-bar--on-light', heroText === DARK_TEXT);
    };

    // ?dawn=0.65 pins the timeline for design review and screenshots.
    const pinned = new URLSearchParams(window.location.search).get('dawn');
    if (pinned !== null && !Number.isNaN(Number(pinned))) {
      hero.classList.add('hero--settled');
      apply(Math.max(0, Math.min(1, Number(pinned))));
    } else {
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          // The hero's own scroll travel, not one viewport: .hero is taller than
          // its sticky viewport by exactly the distance it stays pinned, and that
          // distance is the whole arc. Deriving it here means the CSS height above
          // is the single place the pacing is set. Guarded against a zero divisor
          // for the degenerate case of a viewport taller than the hero.
          const travel = hero.offsetHeight - window.innerHeight;
          const progress = travel > 0 ? window.scrollY / travel : 1;
          apply(Math.max(0, Math.min(1, progress)));
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // will-change only while the hero is on screen.
      new IntersectionObserver((entries) => {
        for (const entry of entries) {
          hero.classList.toggle('hero--in-view', entry.isIntersecting);
        }
      }).observe(hero);
    }
  }
</script>
