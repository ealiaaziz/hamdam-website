---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import { getBrisbaneToday } from '../lib/countdown';
import { upcomingRootsMoments, matchesHeritageAndRegion, countryForRegion } from '../lib/rootsMoments';
import { ROOTS_MOMENTS, ROOTS_LABELS, HERITAGE_COUNTRIES, ROADMAP_COUNTRIES, AU_REGIONS } from '../data/rootsMoments';
import momentYalda from '../assets/website-redesign/moment-yalda.png';
import momentNorooz from '../assets/website-redesign/moment-norooz.png';
import momentChaharshanbeSuri from '../assets/website-redesign/moment-chaharshanbe-suri.png';
import deviceFrame from '../assets/website-redesign/device-frame-iphone.png';
import rootsScreenshotEn from '../assets/website-redesign/screenshots/EN/04-roots-en.png';
import rootsScreenshotFa from '../assets/website-redesign/screenshots/FA/04-roots-fa.png';

const CARD_IMAGE: Record<string, ImageMetadata> = {
  yalda: momentYalda,
  norooz: momentNorooz,
  chaharshanbeSuri: momentChaharshanbeSuri,
};

const CARD_ALT: Record<string, { en: string; fa: string }> = {
  yalda: { en: 'Pomegranates and candlelight for Yalda night', fa: 'انار و شمع برای شب یلدا' },
  norooz: { en: 'Spring blossoms in morning light for Norooz', fa: 'شکوفه‌های بهاری در نور صبح برای نوروز' },
  chaharshanbeSuri: { en: 'Fire glow at dusk for Chaharshanbe Suri', fa: 'شعله‌ی آتش در غروب برای چهارشنبه‌سوری' },
};

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;
const rootsScreenshot = lang === 'fa' ? rootsScreenshotFa : rootsScreenshotEn;

// Rebuilt 2026-07-25 on the app's universal heritage/region model (handoff:
// docs/website-redesign/33-universal-roots-and-homepage-handoff.md). Roots is
// two independent sections in RootsTabView, gated differently, and the old
// fixed Yalda/Norooz/Chaharshanbe Suri row could only ever show the first one:
//
//   Section 1 "Where you come from" -- .culturalHeritage, gated by heritage.
//   Section 2 "Where you live"      -- .governmentPublic, gated by REGION ONLY.
//
// The catalogue and every label below are generated from the shipped app, never
// hand-typed (scripts/generate-roots-data.mjs). No new Farsi is authored here.
//
// Computed at build time in Australia/Brisbane, like the countdown it replaces.
// The whole catalogue renders once, date-sorted; the switcher then filters by
// class alone, which stays inside CSP (no inline styles, no re-render) and
// keeps the order correct for every selection, since a subset of a sorted list
// is still sorted.
const today = getBrisbaneToday();
const upcoming = upcomingRootsMoments(ROOTS_MOMENTS, today);

// The illustrative default, and what a visitor with no JavaScript sees: the
// pairing the app's own screenshots use (Iranian heritage, Queensland).
const DEFAULT_HERITAGE = 'IR';
const DEFAULT_REGION = 'AU-QLD';
const MAX_VISIBLE = 4;

const formatDate = (date: { year: number; month: number; day: number }) =>
  new Intl.DateTimeFormat(lang === 'fa' ? 'fa-IR' : 'en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(Date.UTC(date.year, date.month - 1, date.day, 12));

function countdownText(daysUntil: number, name: string): string {
  if (lang === 'fa') {
    if (daysUntil === 0) return `${name} امروز می‌رسد.`;
    if (daysUntil === 1) return `${name} فردا می‌رسد.`;
    return `${name} تا ${daysUntil.toLocaleString('fa-IR')} روز دیگر می‌رسد.`;
  }
  if (daysUntil === 0) return `${name} arrives today.`;
  if (daysUntil === 1) return `${name} arrives tomorrow.`;
  return `${name} arrives in ${daysUntil} days.`;
}

// EN/FA sentence pairs reused byte-exact from the shipped app's
// momentMeaning(id:_:) in Localization.swift (Roots MomentDetailSheet) --
// EN authored per Ealia's spec, FA authored by Claude with a
// SIMA-review-pending flag already carried in the app itself; that same
// pending status applies here, not a new gap this phase introduces.
//
// Only these three have an approved sentence. Mehregan, Sizdah Bedar, Tirgan
// and Sepandarmazgan deliberately render as name plus countdown rather than
// carrying invented copy, per the handoff's content rules.
const CARD_COPY: Record<string, { sentenceEn: string; sentenceFa: string }> = {
  yalda: {
    sentenceEn: 'The longest night of the year, when families gather to read Hafez, share pomegranates and watermelon, and welcome the return of the sun.',
    sentenceFa: 'طولانی‌ترین شب سال، وقتی خانواده‌ها دور هم جمع می‌شوند تا حافظ بخوانند، انار و هندوانه به اشتراک بگذارند، و بازگشت خورشید را خوش‌آمد بگویند.',
  },
  norooz: {
    sentenceEn: 'The first day of spring, marking renewal, rebirth, and the balance of light and dark.',
    sentenceFa: 'نخستین روز بهار، نشانه‌ی تجدید، تولدی دوباره، و توازن روشنایی و تاریکی.',
  },
  chaharshanbeSuri: {
    sentenceEn: "The last Tuesday night before Norooz, when people leap over small fires whispering 'give me your redness, take my paleness.'",
    sentenceFa: 'شب سه‌شنبه‌ی آخر پیش از نوروز، وقتی مردم از روی آتش‌های کوچک می‌پرند و زمزمه می‌کنند «سرخی تو از من، زردی من از تو».',
  },
};

const defaultSelection = {
  heritages: [DEFAULT_HERITAGE],
  homeRegion: DEFAULT_REGION,
  homeCountry: countryForRegion(DEFAULT_REGION),
};

function rowsFor(source: 'culturalHeritage' | 'governmentPublic') {
  let shown = 0;
  return upcoming
    .filter((entry) => entry.moment.source === source)
    .map((entry) => {
      const name = (lang === 'fa' && entry.moment.nameFa) || entry.moment.nameEn;
      const visible = matchesHeritageAndRegion(entry.moment, defaultSelection);
      const withinCap = visible && shown < MAX_VISIBLE;
      if (visible) shown += 1;
      return {
        ...entry,
        name,
        visible,
        withinCap,
        featured: withinCap && shown === 1,
        date: formatDate(entry.date),
        countdown: countdownText(entry.daysUntil, name),
        sentence: lang === 'fa' ? CARD_COPY[entry.moment.id]?.sentenceFa : CARD_COPY[entry.moment.id]?.sentenceEn,
      };
    });
}

const heritageRows = rowsFor('culturalHeritage');
const regionRows = rowsFor('governmentPublic');

const label = (key: keyof typeof ROOTS_LABELS) => ROOTS_LABELS[key][lang];
const placeName = (place: { nameEn: string; nameFa?: string }) =>
  (lang === 'fa' && place.nameFa) || place.nameEn;

// EN copy below is DRAFT and needs Ealia's sign-off, same as every other
// section (docs/website-redesign/32-fable-approved-copy-ledger.md). The FA
// heading and closing line are the previously approved strings, kept
// byte-exact: they still read true on a Farsi page, but they frame Roots as
// Persian-only and want Ealia's own universal rewrite, which is hers to author.
const copy =
  lang === 'fa'
    ? {
        heading: 'یلدا، نوروز، چهارشنبه‌سوری. همدم می‌داند کِی از راه می‌رسند، و آن‌ها را با شعری که به خودشان تعلق دارد خوش‌آمد می‌گوید.',
        closing: 'مهرگان و سیزده بدر هم علامت‌گذاری شده‌اند، هرکدام با آمدنی آرام.',
        falHafez: 'همان‌گونه که نسل‌ها پرسیده‌اند، بپرس.',
        deviceAlt: 'صفحه ریشه‌های همدم با فال حافظ و تقویم فرهنگی',
        note: null,
      }
    : {
        heading: 'Hamdam keeps the days that matter where you come from, and where you live.',
        closing: 'You choose both in the app. Nothing here is read from your device.',
        falHafez: 'Ask, as generations have.',
        deviceAlt: 'Hamdam Roots screen with Fal-e Hafez and the cultural calendar',
        note: 'Ekka is a Brisbane holiday rather than a statewide one, and Boxing Day shows its observed date when 26 December falls on a weekend.',
      };
---

<section class="roots" aria-labelledby="roots-title">
  <div class="roots__inner">
    <div class="roots__content">
      <h2 id="roots-title" class="roots__heading text-balance">{copy.heading}</h2>

      <form class="roots__switcher" data-roots-switcher>
        <fieldset class="roots__group">
          <legend class="roots__legend">{label('heritage')}</legend>
          <div class="roots__chips">
            {HERITAGE_COUNTRIES.map((country) => (
              <label class="roots__chip">
                <input
                  type="radio"
                  name="roots-heritage"
                  value={country.code}
                  checked={country.code === DEFAULT_HERITAGE}
                />
                <span>{placeName(country)}</span>
              </label>
            ))}
            <label class="roots__chip">
              <input type="radio" name="roots-heritage" value="" />
              <span>{label('notSet')}</span>
            </label>
          </div>
        </fieldset>

        <fieldset class="roots__group">
          <legend class="roots__legend">{label('region')}</legend>
          <div class="roots__chips">
            {AU_REGIONS.map((region) => (
              <label class="roots__chip">
                <input
                  type="radio"
                  name="roots-region"
                  value={region.code}
                  checked={region.code === DEFAULT_REGION}
                />
                <span>{region.nameEn}</span>
              </label>
            ))}
            <label class="roots__chip">
              <input type="radio" name="roots-region" value="" />
              <span>{label('notSet')}</span>
            </label>
          </div>
          <p class="roots__roadmap">
            <span class="roots__roadmap-label">{label('comingSoon')}</span>
            {ROADMAP_COUNTRIES.map((country) => (
              <span class="roots__roadmap-country">{placeName(country)}</span>
            ))}
          </p>
        </fieldset>
      </form>

      <div class="roots__columns" data-reveal-group>
        <div class="roots__column" data-roots-column="heritage" data-reveal>
          <h3 class="roots__column-title">{label('heritage')}</h3>
          <ul class="roots__list">
            {heritageRows.map((row) => (
              <li
                class:list={[
                  'roots__row',
                  !row.withinCap && 'roots__row--hidden',
                  row.featured && 'roots__row--featured',
                ]}
                data-moment={row.moment.id}
                data-source={row.moment.source}
                data-heritages={row.moment.heritages.join(' ')}
                data-regions={row.moment.regions ? row.moment.regions.join(' ') : null}
              >
                {CARD_IMAGE[row.moment.id] && (
                  <div class="roots__row-image">
                    <Image
                      src={CARD_IMAGE[row.moment.id]}
                      alt={lang === 'fa' ? CARD_ALT[row.moment.id].fa : CARD_ALT[row.moment.id].en}
                      width={CARD_IMAGE[row.moment.id].width}
                      height={CARD_IMAGE[row.moment.id].height}
                      class="roots__row-image-img"
                    />
                  </div>
                )}
                <p class="roots__row-name">{row.name}</p>
                <p class="roots__row-date">{row.date}</p>
                {row.sentence && <p class="roots__row-sentence">{row.sentence}</p>}
                <p class="roots__row-countdown">{row.countdown}</p>
              </li>
            ))}
          </ul>
          <p class="roots__empty">{label('heritageEmpty')}</p>
        </div>

        <div class="roots__column" data-roots-column="region" data-reveal>
          <h3 class="roots__column-title">{label('region')}</h3>
          <ul class="roots__list">
            {regionRows.map((row) => (
              <li
                class:list={[
                  'roots__row',
                  !row.withinCap && 'roots__row--hidden',
                  row.featured && 'roots__row--featured',
                ]}
                data-moment={row.moment.id}
                data-source={row.moment.source}
                data-heritages={row.moment.heritages.join(' ')}
                data-regions={row.moment.regions ? row.moment.regions.join(' ') : null}
              >
                <p class="roots__row-name">{row.name}</p>
                <p class="roots__row-date">{row.date}</p>
                <p class="roots__row-countdown">{row.countdown}</p>
              </li>
            ))}
          </ul>
          <p class="roots__empty">{label('regionEmpty')}</p>
        </div>
      </div>

      <p class="roots__closing">{copy.closing}</p>
      {copy.note && <p class="roots__note">{copy.note}</p>}
      <p class="roots__fal">{copy.falHafez}</p>
    </div>

    {
      /* Real orchestrator 04-roots screenshot composited 2026-07-19,
         same cutout-position math as every other DV-01 consumer -- see
         HeroCinematic.astro's .hero__device-screen comment for the
         measurement method. */
    }
    <div class="roots__device" role="img" aria-label={copy.deviceAlt}>
      <Image
        src={rootsScreenshot}
        alt=""
        width={578}
        height={1255}
        quality={80}
        class="roots__device-screen"
      />
      <Image
        src={deviceFrame}
        alt=""
        width={520}
        height={Math.round((520 / deviceFrame.width) * deviceFrame.height)}
        quality={72}
        class="roots__device-frame"
      />
    </div>
  </div>
</section>

<style>
  .roots {
    padding-block: var(--spacing-section-mobile);
    padding-inline: 1.5rem;
    background-color: var(--surface-firstlight);
    color: var(--text-on-night);
  }
  @media (min-width: 640px) {
    .roots {
      padding-block: var(--spacing-section-desktop);
    }
  }

  .roots__inner {
    max-width: 1200px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .roots__heading {
    text-align: center;
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: 600;
  }
  :global([lang='fa']) .roots__heading {
    font-family: var(--font-farsi);
    font-weight: 500;
  }

  /* --- Switcher --------------------------------------------------------- */

  .roots__switcher {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .roots__group {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .roots__legend {
    padding: 0;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--hamdam-night-gold);
  }
  :global([lang='fa']) .roots__legend {
    font-family: var(--font-farsi);
    text-transform: none;
    letter-spacing: normal;
  }

  .roots__chips {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .roots__chip {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 1rem;
    border: 1px solid rgb(244 237 216 / 0.28);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    line-height: 1.2;
    cursor: pointer;
  }
  :global([lang='fa']) .roots__chip {
    font-family: var(--font-farsi);
  }

  /* The radio itself carries focus and checked state; hiding it visually
     without removing it from the accessibility tree keeps keyboard and
     screen-reader behaviour native (arrow keys move within the group). */
  .roots__chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .roots__chip:has(input:checked) {
    background: var(--hamdam-night-gold);
    border-color: var(--hamdam-night-gold);
    color: var(--surface-night);
    font-weight: 600;
  }

  .roots__chip:has(input:focus-visible) {
    outline: 2px solid var(--focus-color-dark);
    outline-offset: 2px;
  }

  .roots__roadmap {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    color: var(--text-on-night-muted);
  }
  :global([lang='fa']) .roots__roadmap {
    font-family: var(--font-farsi);
  }
  .roots__roadmap-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  :global([lang='fa']) .roots__roadmap-label {
    text-transform: none;
    letter-spacing: normal;
  }
  .roots__roadmap-country {
    padding: 0.25rem 0.75rem;
    border: 1px dashed rgb(244 237 216 / 0.24);
    border-radius: 999px;
  }

  /* --- Columns ---------------------------------------------------------- */

  .roots__columns {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .roots__column {
    flex: 1;
  }

  .roots__column-title {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 600;
  }
  :global([lang='fa']) .roots__column-title {
    font-family: var(--font-farsi);
    font-weight: 500;
  }

  .roots__list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .roots__row {
    padding: 1rem;
    border-radius: var(--radius-card);
    background: rgb(244 237 216 / 0.04);
    border: 1px solid transparent;
  }

  .roots__row--hidden {
    display: none;
  }

  .roots__row--featured {
    border-color: var(--hamdam-night-gold);
    padding: 0;
    overflow: hidden;
  }
  .roots__row--featured .roots__row-name,
  .roots__row--featured .roots__row-date,
  .roots__row--featured .roots__row-sentence,
  .roots__row--featured .roots__row-countdown {
    padding-inline: 1rem;
  }
  .roots__row--featured .roots__row-name {
    padding-top: 1rem;
  }
  .roots__row--featured .roots__row-countdown {
    padding-bottom: 1rem;
  }

  /* Nearest-upcoming moment: once-per-load soft glow pulse (2s, one time);
     reduced motion drops the pulse for a static border tone instead
     (page spec §7 items 7-8). */
  @media (prefers-reduced-motion: no-preference) {
    .roots__row--featured {
      animation: roots-pulse 2s var(--ease-cross) 1;
    }
  }
  @keyframes roots-pulse {
    0%, 100% { box-shadow: 0 0 0 var(--glow-warm); }
    50% { box-shadow: 0 0 32px var(--glow-warm); }
  }

  /* The image and the sentence are the featured row's own treatment: every
     other row is a name, a date and a countdown, so the list stays readable
     however many moments a selection resolves. */
  .roots__row-image {
    display: none;
  }
  .roots__row--featured .roots__row-image {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    background: linear-gradient(160deg, var(--surface-dusk), var(--surface-night));
    overflow: hidden;
  }
  .roots__row-image-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .roots__row-name {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--text-on-night);
  }
  :global([lang='fa']) .roots__row-name {
    font-family: var(--font-farsi);
    font-weight: 500;
  }

  .roots__row-date {
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--hamdam-night-gold);
  }
  :global([lang='fa']) .roots__row-date {
    font-family: var(--font-farsi);
    text-transform: none;
    letter-spacing: normal;
  }

  .roots__row-sentence {
    display: none;
  }
  .roots__row--featured .roots__row-sentence {
    display: block;
    margin-top: 0.75rem;
    font-size: var(--text-body);
    line-height: 1.6;
    opacity: 0.85;
  }

  .roots__row-countdown {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: var(--text-body);
  }
  :global([lang='fa']) .roots__row-countdown {
    font-family: var(--font-farsi);
    font-style: normal;
  }

  .roots__empty {
    display: none;
    margin-top: 1rem;
    font-size: var(--text-body);
    color: var(--text-on-night-muted);
  }
  :global([lang='fa']) .roots__empty {
    font-family: var(--font-farsi);
  }
  .roots__column--empty .roots__empty {
    display: block;
  }

  .roots__closing {
    margin-top: 2rem;
    text-align: center;
    font-size: var(--text-body);
    opacity: 0.8;
  }
  :global([lang='fa']) .roots__closing {
    font-family: var(--font-farsi);
  }

  .roots__note {
    margin-top: 0.75rem;
    text-align: center;
    font-size: var(--text-meta);
    color: var(--text-on-night-muted);
  }

  .roots__fal {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-body);
    opacity: 0.9;
  }
  :global([lang='fa']) .roots__fal {
    font-family: var(--font-farsi);
    font-style: normal;
  }

  .roots__device {
    position: relative;
    width: min(220px, 55vw);
    aspect-ratio: 1290 / 2796;
    margin-inline: auto;
    border-radius: var(--radius-device);
    background: linear-gradient(to bottom, var(--surface-dusk), var(--surface-night));
    box-shadow: var(--shadow-lift);
    overflow: hidden;
  }
  .roots__device-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .roots__device-screen {
    /* Explicit width/height, not auto + all four insets -- see
       JourneyPair.astro's .journey__frame-screen comment for why (replaced-
       element over-constraint bug, confirmed live: insets were silently
       not shrinking the image at all). */
    position: absolute;
    top: 5.97%;
    left: 6.43%;
    width: 87.5%;
    height: 87.62%;
    object-fit: cover;
    border-radius: 8%;
  }

  /* Desktop: the two sections sit side by side, device frame anchors the
     inline-end (logical property, mirrors for FA automatically). */
  @media (min-width: 1024px) {
    .roots__inner {
      flex-direction: row;
      align-items: center;
    }
    .roots__content {
      flex: 1;
    }
    .roots__columns {
      flex-direction: row;
      align-items: flex-start;
    }
    .roots__device {
      flex: 0 0 220px;
      margin-inline: 0;
      margin-inline-start: 2.5rem;
    }
  }
</style>

<script>
  import { matchesHeritageAndRegion, countryForRegion } from '../lib/rootsMoments';

  const MAX_VISIBLE = 4;
  const switcher = document.querySelector<HTMLFormElement>('[data-roots-switcher]');
  const columns = Array.from(document.querySelectorAll<HTMLElement>('[data-roots-column]'));

  if (switcher && columns.length) {
    // Each row carries its own gating data, so the client reuses the exact
    // predicate the build used rather than a second, drifting copy of it.
    const metaFor = (row: HTMLElement) => ({
      source: row.dataset.source,
      heritages: (row.dataset.heritages || '').split(' ').filter(Boolean),
      regions: row.dataset.regions ? row.dataset.regions.split(' ').filter(Boolean) : null,
    });

    const apply = () => {
      const data = new FormData(switcher);
      const heritage = String(data.get('roots-heritage') || '');
      const homeRegion = String(data.get('roots-region') || '') || null;
      const selection = {
        heritages: heritage ? [heritage] : [],
        homeRegion,
        homeCountry: countryForRegion(homeRegion),
      };

      for (const column of columns) {
        let shown = 0;
        for (const row of Array.from(column.querySelectorAll<HTMLElement>('.roots__row'))) {
          const matches = matchesHeritageAndRegion(metaFor(row), selection);
          // Rows are already date-sorted, so the first match is the nearest
          // arrival and the cap simply takes the next few after it.
          const withinCap = matches && shown < MAX_VISIBLE;
          if (matches) shown += 1;
          row.classList.toggle('roots__row--hidden', !withinCap);
          row.classList.toggle('roots__row--featured', withinCap && shown === 1);
        }
        column.classList.toggle('roots__column--empty', shown === 0);
      }
    };

    switcher.addEventListener('change', apply);
    apply();
  }
</script>
