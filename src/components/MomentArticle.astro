---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import { getBrisbaneToday } from '../lib/countdown';
import { countdownText, formatMomentDate, upcomingOccurrences } from '../lib/momentText';
import { ROOTS_MOMENTS } from '../data/rootsMoments';
import { MOMENT_ALT, MOMENT_COPY, MOMENT_SLUGS, MOMENT_PAGE_IDS, MOMENT_UI } from '../data/momentContent';
import { FAL_HAFEZ } from '../data/falHafez';
import { APP_STORE, appStoreUrl } from '../lib/appStore';
import momentYalda from '../assets/website-redesign/moment-yalda.png';
import momentNorooz from '../assets/website-redesign/moment-norooz.png';
import momentChaharshanbeSuri from '../assets/website-redesign/moment-chaharshanbe-suri.png';

// One page body for the three cultural moments that have a page, EN and FA.
//
// Built 2026-08-07 as the first of the content cluster an SEO audit asked for.
// These three went first for a reason that is a constraint, not a preference:
// they are the only moments with copy already approved in BOTH languages
// (MOMENT_COPY, from the shipped app), so the pair ships at equal quality with
// no Persian authored here. The poet and Fal-e Hafez pages the audit also
// wants cannot be built the same way: their verse text would have to come from
// src/data/verses.ts, whose English is the AI-generated translation FACTS.md
// marks CONTESTED, and putting that into the index permanently is the exact
// failure the public domain replacement (Nicholson, Whinfield, Bell) exists to
// undo.
//
// Where the Farsi page has no approved string for a piece of chrome, the
// chrome is omitted rather than invented. That is the precedent RootsMoments
// already set with its `note: null`. It is why nothing below has a section
// heading: each date line is a whole sentence in both languages already
// ("Yalda arrives in 136 days." / the Farsi equivalent), so it reads correctly
// with no label above it, and no label had to be made up to make it do so.

interface Props {
  lang: 'en' | 'fa';
  momentId: string;
}

const { lang, momentId } = Astro.props;

const IMAGE: Record<string, ImageMetadata> = {
  yalda: momentYalda,
  norooz: momentNorooz,
  chaharshanbeSuri: momentChaharshanbeSuri,
};

const moment = ROOTS_MOMENTS.find((m) => m.id === momentId);
if (!moment) throw new Error(`MomentArticle: unknown moment id "${momentId}"`);

const name = (lang === 'fa' && moment.nameFa) || moment.nameEn;
const sentence = lang === 'fa' ? MOMENT_COPY[momentId].sentenceFa : MOMENT_COPY[momentId].sentenceEn;
// English only, and empty on the Farsi page by design. See the note on
// MomentSentence.bodyEn: authoring the Farsi half is Ealia's call, so the Farsi
// page keeps its approved sentence rather than carrying a machine-written body.
// Same trade the poet pages already make for biographyEn.
const body = lang === 'fa' ? [] : (MOMENT_COPY[momentId].bodyEn ?? []);
const alt = lang === 'fa' ? MOMENT_ALT[momentId].fa : MOMENT_ALT[momentId].en;

// Build-time, in Brisbane, the same basis as the homepage countdown. Four
// occurrences: enough to be worth the visit, and upcomingOccurrences returns
// fewer rather than inventing a year the app never banked.
const today = getBrisbaneToday();
const occurrences = upcomingOccurrences(moment.rule, today, 4).map((entry) => ({
  date: formatMomentDate(lang, entry.date),
  iso: `${entry.date.year}-${String(entry.date.month).padStart(2, '0')}-${String(entry.date.day).padStart(2, '0')}`,
  countdown: countdownText(lang, entry.daysUntil, name),
}));

// The other two moments, for internal linking. Visible link text is the moment
// name, which exists in both languages, so the list needs no group label.
const siblings = MOMENT_PAGE_IDS.filter((id) => id !== momentId).map((id) => {
  const sibling = ROOTS_MOMENTS.find((m) => m.id === id)!;
  return {
    name: (lang === 'fa' && sibling.nameFa) || sibling.nameEn,
    href: lang === 'fa' ? `/fa/moments/${MOMENT_SLUGS[id]}/` : `/moments/${MOMENT_SLUGS[id]}/`,
  };
});

// Every string below comes from MOMENT_UI, which holds them byte-exact from
// the components that already owned them. Nothing is typed here.
const bridge = MOMENT_UI.bridge[lang];
// Yalda is the night the Divan comes out, so its page points at the practice.
// The other two moments have no such association and get no such link.
if (momentId === 'yalda') {
  siblings.unshift({
    name: lang === 'fa' ? FAL_HAFEZ.titleFa : FAL_HAFEZ.titleEn,
    href: lang === 'fa' ? `/fa/${FAL_HAFEZ.slug}/` : `/${FAL_HAFEZ.slug}/`,
  });
}

const homeHref = lang === 'fa' ? '/fa/' : '/';
const homeLabel = MOMENT_UI.home[lang];
const ctaLabel = MOMENT_UI.cta[lang];
---

<article class="moment">
  <div class="moment__inner">
    <p class="moment__crumb">
      <a href={homeHref}>{homeLabel}</a>
    </p>

    <h1 class="moment__title text-balance">{name}</h1>

    <div class="moment__figure">
      <Image
        src={IMAGE[momentId]}
        alt={alt}
        width={IMAGE[momentId].width}
        height={IMAGE[momentId].height}
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 800px, 100vw"
        quality={78}
        loading="eager"
        fetchpriority="high"
        class="moment__figure-img"
      />
    </div>

    <p class="moment__sentence text-balance">{sentence}</p>

    {
      body.length > 0 && (
        <div class="moment__body">
          {body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )
    }

    {
      /* Each row is a complete sentence in both languages, which is what lets
         this list carry no heading. See the note at the top of this file. */
    }
    {
      occurrences.length > 0 && (
        <ul class="moment__dates">
          {occurrences.map((entry, i) => (
            <li class:list={['moment__date', i === 0 && 'moment__date--next']}>
              <time class="moment__date-value" datetime={entry.iso}>
                {entry.date}
              </time>
              <p class="moment__date-countdown">{entry.countdown}</p>
            </li>
          ))}
        </ul>
      )
    }

    <p class="moment__bridge text-balance">{bridge}</p>

    {
      APP_STORE.RELEASED && (
        <p class="moment__cta-row">
          <a
            class="moment__cta"
            href={appStoreUrl(lang, null, 'moment')}
            data-store-cta
          >
            {ctaLabel}
          </a>
        </p>
      )
    }

    <ul class="moment__siblings">
      {
        siblings.map((sibling) => (
          <li>
            <a href={sibling.href}>{sibling.name}</a>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .moment {
    padding-block: 6rem 5rem;
    padding-inline: 1.5rem;
    background-color: var(--surface-firstlight);
    color: var(--text-on-night);
  }
  @media (min-width: 640px) {
    .moment {
      padding-block: 7.5rem 6rem;
    }
  }

  .moment__inner {
    max-width: var(--container-reading);
    margin-inline: auto;
  }

  .moment__crumb {
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    color: var(--text-on-night-muted);
  }
  :global([lang='fa']) .moment__crumb {
    font-family: var(--font-farsi);
  }
  .moment__crumb a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .moment__crumb a:hover {
    color: var(--text-on-night);
  }

  /* --text-display, not --text-h1: there is no --text-h1 token. The scale in
     global.css runs display / h2 / h3, and the page title is the display role.
     Farsi takes the 6% larger variant the scale defines for exactly this role
     (design-system.md §4). */
  .moment__title {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 1.1;
  }
  :global([lang='fa']) .moment__title {
    font-family: var(--font-farsi);
    font-size: var(--text-display-fa);
    font-weight: 500;
    line-height: 1.3;
  }

  /* Aspect ratio reserved up front so the image cannot shift the sentence
     below it when it decodes. */
  .moment__figure {
    margin-top: 2rem;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: linear-gradient(160deg, var(--surface-dusk), var(--surface-night));
  }
  .moment__figure-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .moment__sentence {
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.7;
  }
  :global([lang='fa']) .moment__sentence {
    font-family: var(--font-farsi);
    font-size: var(--text-body-fa);
  }
  /* The body paragraphs sit a step quieter than the opening sentence, which
     keeps that sentence as the page's lead rather than the first of six. English
     only, so no Farsi font override is needed here. */
  .moment__body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 1.75rem;
    max-width: 38rem;
  }
  .moment__body p {
    margin: 0;
    /* Body size, not --text-meta. This is five paragraphs of reading prose, and
       meta size computed to under 14px, which is too small to read comfortably
       and would be the smallest running text on the site. The step down from
       the opening sentence is carried by colour instead. */
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--text-on-night-muted);
  }

  .moment__dates {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .moment__date {
    padding: 1rem;
    border-radius: var(--radius-card);
    background: rgb(244 237 216 / 0.04);
    border: 1px solid transparent;
  }
  .moment__date--next {
    border-color: var(--hamdam-night-gold);
  }
  /* Set by the script below when a date has passed and the page has not been
     rebuilt since. Explicit because [hidden] loses to a flex item's display. */
  .moment__date[hidden],
  .moment__dates[hidden] {
    display: none;
  }

  .moment__date-value {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--hamdam-night-gold);
  }
  :global([lang='fa']) .moment__date-value {
    font-family: var(--font-farsi);
    text-transform: none;
    letter-spacing: normal;
  }

  .moment__date-countdown {
    margin-top: 0.25rem;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-on-night);
  }
  :global([lang='fa']) .moment__date-countdown {
    font-family: var(--font-farsi);
    font-style: normal;
  }

  .moment__bridge {
    margin-top: 3rem;
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    line-height: 1.6;
    color: var(--text-on-night);
  }
  :global([lang='fa']) .moment__bridge {
    font-family: var(--font-farsi);
  }

  .moment__cta-row {
    margin-top: 1.5rem;
  }
  .moment__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 1.5rem;
    border-radius: var(--radius-button);
    background: var(--hamdam-night-gold);
    color: var(--surface-night);
    font-family: var(--font-sans);
    font-weight: 600;
  }
  :global([lang='fa']) .moment__cta {
    font-family: var(--font-farsi);
  }
  .moment__cta:hover {
    filter: brightness(1.06);
  }

  .moment__siblings {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(244 237 216 / 0.16);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-family: var(--font-serif);
  }
  :global([lang='fa']) .moment__siblings {
    font-family: var(--font-farsi);
  }
  .moment__siblings a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--hamdam-night-gold);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .moment__siblings a:hover {
    color: var(--text-on-night);
  }
</style>

<script>
  // Self-healing countdowns.
  //
  // The dates and the "arrives in N days" line are both computed at build time,
  // which is correct the day it builds and drifts every day after. That matters
  // here more than anywhere else on the site: these pages exist for seasonal
  // search, so the moment they finally earn traffic (Yalda in December, Norooz
  // in March) is the moment they are most likely to be months stale, telling a
  // visitor a confidently wrong number.
  //
  // The alternative considered was a scheduled rebuild. It was rejected for two
  // reasons. The CI workflow's own header states that CI does not deploy and
  // must never deploy, and a cron that pushes to trigger Workers Builds depends
  // on webhook behaviour that cannot be verified from a development machine, so
  // its failure mode is silent and indistinguishable from the bug it fixes.
  // This runs in the visitor's browser, needs no credentials and no
  // infrastructure, and is testable now by moving the clock.
  //
  // It reuses the same two pure functions the server rendered with, so the
  // client can never word the sentence differently from the build, and no new
  // Persian is introduced: countdownText owns both languages already.
  import { getBrisbaneToday, daysBetween } from '../lib/countdown';
  import { countdownText } from '../lib/momentText';

  const list = document.querySelector<HTMLElement>('.moment__dates');
  const rows = [...document.querySelectorAll<HTMLElement>('.moment__date')];

  if (list && rows.length) {
    const lang = document.documentElement.lang === 'fa' ? 'fa' : 'en';
    // The h1 is the moment's name in the page's own language, which is exactly
    // the string the server passed to countdownText.
    const name = document.querySelector('.moment__title')?.textContent?.trim() ?? '';
    const today = getBrisbaneToday();
    let seenUpcoming = false;

    for (const row of rows) {
      const iso = row.querySelector('time')?.getAttribute('datetime');
      if (!iso) continue;
      const [year, month, day] = iso.split('-').map(Number);
      if (!year || !month || !day) continue;

      const daysUntil = daysBetween(today, { year, month, day });

      if (daysUntil < 0) {
        // Already happened, and the page has not been rebuilt since.
        row.hidden = true;
        row.classList.remove('moment__date--next');
        continue;
      }

      row.hidden = false;
      const countdown = row.querySelector('.moment__date-countdown');
      if (countdown && name) countdown.textContent = countdownText(lang, daysUntil, name);
      // The gold border belongs to the nearest date still ahead, which is not
      // the one the build chose once the build's choice has passed.
      row.classList.toggle('moment__date--next', !seenUpcoming);
      seenUpcoming = true;
    }

    // Every banked date has passed. Showing nothing beats showing a list of
    // dates that are all in the past; the rest of the page still stands.
    list.hidden = !seenUpcoming;
  }
</script>
