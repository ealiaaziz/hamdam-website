---
import { Image } from 'astro:assets';
import deviceFrame from '../assets/website-redesign/device-frame-iphone.png';
import heroScreenshotEn from '../assets/website-redesign/screenshots/EN/01-hero-en.png';
import heroScreenshotFa from '../assets/website-redesign/screenshots/FA/01-hero-fa.png';
import { CONTEXT_SIGNALS, CONTEXT_SIGNAL_ICONS } from '../data/contextSignals';

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;

// The six signals now live in src/data/contextSignals.ts, shared with the
// privacy section that absorbed them when the homepage went to seven sections.
const NODES = CONTEXT_SIGNALS;

const heading = lang === 'fa' ? 'یک تأمل، شکل‌گرفته از روز تو.' : 'One reflection, shaped by your day.';
const privacyLinkLabel = lang === 'fa' ? 'ببین چطور خصوصی می‌ماند' : 'See how it stays private';
const heroScreenshot = lang === 'fa' ? heroScreenshotFa : heroScreenshotEn;
const deviceAlt =
  lang === 'fa'
    ? 'نمای صفحه اصلی همدم با شعری صبحگاهی از حافظ'
    : 'Hamdam Today screen showing a morning verse by Hafez';

const NODE_ICONS = CONTEXT_SIGNAL_ICONS;
---

<section class="constellation" aria-labelledby="constellation-title">
  <div class="constellation__inner">
    <h2 id="constellation-title" class="constellation__heading text-balance">{heading}</h2>

    <div class="constellation__diagram">
      <div class="constellation__device" role="img" aria-label={deviceAlt}>
        <Image
          src={heroScreenshot}
          alt=""
          width={578}
          height={1255}
          quality={80}
          class="constellation__device-screen"
        />
        <Image
          src={deviceFrame}
          alt=""
          width={520}
          height={Math.round((520 / deviceFrame.width) * deviceFrame.height)}
          quality={72}
          class="constellation__device-frame"
        />
      </div>

      {
        /* Hairline arcs are presentation only -- the six signals are real
           content in the <ul> below, never encoded in the arc geometry
           (page spec §5 item 11). Dropped entirely on mobile via CSS. */
      }
      <svg class="constellation__arcs" aria-hidden="true" viewBox="0 0 600 400" preserveAspectRatio="none">
        <g fill="none" stroke="var(--color-divider)" stroke-width="1">
          <path d="M300 200 L60 60" /><path d="M300 200 L60 200" /><path d="M300 200 L60 340" />
          <path d="M300 200 L540 60" /><path d="M300 200 L540 200" /><path d="M300 200 L540 340" />
        </g>
      </svg>

      <ul class="constellation__nodes" data-reveal-group>
        {NODES.map((node) => (
          <li class="constellation__node" data-reveal>
            <svg class="constellation__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={NODE_ICONS[node.id]} />
            </svg>
            <span class="constellation__node-label">{lang === 'fa' ? node.labelFa : node.labelEn}</span>
            <span class="constellation__node-clause">{lang === 'fa' ? node.clauseFa : node.clauseEn}</span>
          </li>
        ))}
      </ul>
    </div>

    <a href="#privacy" class="constellation__link">{privacyLinkLabel}</a>
  </div>
</section>

<style>
  .constellation {
    padding-block: var(--spacing-section-mobile);
    padding-inline: 1.5rem;
    background-color: var(--surface-dawn);
    color: var(--hamdam-text);
  }
  @media (min-width: 640px) {
    .constellation {
      padding-block: var(--spacing-section-desktop);
    }
  }

  .constellation__inner {
    max-width: 1200px;
    margin-inline: auto;
    text-align: center;
  }

  .constellation__heading {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: 600;
  }
  :global([lang='fa']) .constellation__heading {
    font-family: var(--font-farsi);
    font-weight: 500;
  }

  .constellation__diagram {
    position: relative;
    margin-top: 3rem;
  }

  .constellation__device {
    width: min(220px, 55vw);
    aspect-ratio: 1290 / 2796;
    margin-inline: auto;
    border-radius: var(--radius-device);
    background: linear-gradient(to bottom, var(--surface-dusk), var(--surface-firstlight));
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    position: relative;
    z-index: 1;
  }
  .constellation__device-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .constellation__device-screen {
    /* Explicit width/height, not auto + all four insets -- see
       JourneyPair.astro's .journey__frame-screen comment for why (replaced-
       element over-constraint bug, confirmed live: insets were silently
       not shrinking the image at all). */
    position: absolute;
    top: 5.97%;
    left: 6.43%;
    width: 87.5%;
    height: 87.62%;
    object-fit: cover;
    border-radius: 8%;
  }
  .constellation__arcs {
    display: none;
  }

  .constellation__nodes {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 1rem;
    text-align: start;
  }

  .constellation__node {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .constellation__icon {
    width: 24px;
    height: 24px;
    margin-bottom: 0.25rem;
    /* --color-ember reads almost invisibly close to --surface-dawn (this
       section's background) in hue and luminance -- inherit the label's
       own dark text colour instead for real contrast. */
    color: var(--hamdam-text);
  }

  .constellation__node-label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-body);
  }
  :global([lang='fa']) .constellation__node-label {
    font-family: var(--font-farsi);
  }

  .constellation__node-clause {
    font-size: var(--text-meta);
    /* No opacity reduction: inherited --hamdam-text is already only
       5.13:1 on --surface-dawn (Phase 11/12 contrast audit), and even
       90% opacity drops that to 4.45:1, just under the 4.5:1 this small
       text needs. Full opacity is the only safe choice on this bg. */
  }

  .constellation__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: 2.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    /* --color-saffron-ink is tuned for cream (4.98:1); against this
       section's --surface-dawn it measured 1.81:1 in a real Lighthouse
       audit -- a genuine failure, not a false positive. --hamdam-text
       gives 5.13:1 here (verified against every dark-surface section in
       Phase 11's contrast pass). */
    color: var(--hamdam-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Desktop: real constellation ring, three nodes per side, arcs visible. */
  @media (min-width: 1024px) {
    .constellation__diagram {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 420px;
    }
    .constellation__device {
      width: 220px;
      margin-inline: 0;
    }
    .constellation__arcs {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    /* Arc coordinates are physical SVG geometry, not logical properties,
       so RTL needs an explicit flip to mirror alongside the node
       positions above (which already mirror for free via inset-inline-*). */
    :global([dir='rtl']) .constellation__arcs {
      transform: scaleX(-1);
    }
    .constellation__nodes {
      position: absolute;
      inset: 0;
      display: block;
      pointer-events: none;
    }
    .constellation__node {
      position: absolute;
      width: 200px;
      pointer-events: auto;
    }
    .constellation__node:nth-child(1) { top: 8%; inset-inline-start: 2%; text-align: end; }
    .constellation__node:nth-child(2) { top: 44%; inset-inline-start: 0; text-align: end; }
    .constellation__node:nth-child(3) { top: 80%; inset-inline-start: 2%; text-align: end; }
    .constellation__node:nth-child(4) { top: 8%; inset-inline-end: 2%; text-align: start; }
    .constellation__node:nth-child(5) { top: 44%; inset-inline-end: 0; text-align: start; }
    .constellation__node:nth-child(6) { top: 80%; inset-inline-end: 2%; text-align: start; }
  }
</style>
