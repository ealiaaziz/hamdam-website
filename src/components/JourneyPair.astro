---
import { Image } from 'astro:assets';
import AppStoreBadge from './AppStoreBadge.astro';
import deviceFrame from '../assets/website-redesign/device-frame-iphone.png';
import reflectScreenshotEn from '../assets/website-redesign/screenshots/EN/02-reflect-en.png';
import reflectScreenshotFa from '../assets/website-redesign/screenshots/FA/02-reflect-fa.png';
import journeyScreenshotEn from '../assets/website-redesign/screenshots/EN/05-journey-en.png';
import journeyScreenshotFa from '../assets/website-redesign/screenshots/FA/05-journey-fa.png';

// On-page display never exceeds 240px CSS width (.journey__frame's own
// desktop max), so 480px (2x retina headroom) is the real budget-relevant
// output size -- same split as every other DV-01 consumer.
const FRAME_DISPLAY_WIDTH = 480;
const FRAME_DISPLAY_HEIGHT = Math.round((FRAME_DISPLAY_WIDTH / deviceFrame.width) * deviceFrame.height);

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;
const reflectScreenshot = lang === 'fa' ? reflectScreenshotFa : reflectScreenshotEn;
const journeyScreenshot = lang === 'fa' ? journeyScreenshotFa : journeyScreenshotEn;

const copy =
  lang === 'fa'
    ? {
        heading: 'هر تأمل، برای تو نگه داشته می‌شود.',
        body: 'در طول هفته‌ها، همدم آب‌وهوای خودت را به تو نشان می‌دهد: خلق‌وخوی تو، فصل‌های تو، مسیر تو. دفتر خصوصی، نشان‌شده‌ها، و رگه‌ای ملایم که یک روز از قلم افتاده را می‌بخشد.',
        midCta: 'همدم منتظر آشنایی با توست.',
        reflectAlt: 'صفحه تأملات همدم با دفتر خصوصی و نشان‌شده‌ها',
        journeyAlt: 'صفحه سفر شما در همدم با نمودار روند خلق‌وخو',
      }
    : {
        heading: 'Every reflection is kept for you.',
        body: "Over the weeks, Hamdam shows you your own weather: your moods, your seasons, your journey. A private journal, your favourites, and a gentle streak that forgives a missed day.",
        midCta: 'Hamdam is waiting to meet you.',
        reflectAlt: 'Hamdam Reflections screen with private journal and favourites',
        journeyAlt: 'Hamdam Your Journey screen with a mood-trend chart',
      };
---

<section class="journey" aria-labelledby="journey-title">
  <div class="journey__inner">
    <div class="journey__copy">
      <h2 id="journey-title" class="journey__heading text-balance">{copy.heading}</h2>
      <p class="journey__body">{copy.body}</p>
    </div>

    {
      /* Real orchestrator 02-reflect/05-journey screenshots composited
         2026-07-19, same cutout-position math as every other DV-01
         consumer -- see HeroCinematic.astro's .hero__device-screen
         comment for the measurement method. Offset ~15%, front one swaps
         on pointerenter/tap -- reduced motion keeps the swap (it's a
         state change, not decoration) but drops the scale nudge. */
    }
    <div class="journey__frames" data-journey-frames>
      <button
        type="button"
        class="journey__frame journey__frame--reflect journey__frame--front"
        data-frame="reflect"
        aria-label={copy.reflectAlt}
      >
        <Image
          src={reflectScreenshot}
          alt=""
          width={630}
          height={1368}
          quality={80}
          class="journey__frame-screen"
        />
        <Image
          src={deviceFrame}
          alt=""
          width={FRAME_DISPLAY_WIDTH}
          height={FRAME_DISPLAY_HEIGHT}
          quality={72}
          class="journey__frame-img"
        />
      </button>
      <button
        type="button"
        class="journey__frame journey__frame--journey"
        data-frame="journey"
        aria-label={copy.journeyAlt}
      >
        <Image
          src={journeyScreenshot}
          alt=""
          width={630}
          height={1368}
          quality={80}
          class="journey__frame-screen"
        />
        <Image
          src={deviceFrame}
          alt=""
          width={FRAME_DISPLAY_WIDTH}
          height={FRAME_DISPLAY_HEIGHT}
          quality={72}
          class="journey__frame-img"
        />
      </button>
    </div>
  </div>

  <div class="journey__mid-cta" data-store-cta="mid">
    <p class="journey__mid-line">{copy.midCta}</p>
    <AppStoreBadge lang={lang} class="journey__mid-badge" placement="journey" />
  </div>
</section>

<style>
  /* Day arc, forenoon into afternoon (2026-08-14). This was a flat
     --surface-dawn (#C77E4E) slab, the most saturated field on the page and
     the first of three that made the old page read as stripes. It is now the
     top of the descent: the section enters at the cream the copy above it
     ends on and leaves at afternoon, so there is no edge at either end. Dark
     text throughout -- afternoon is the last stop where --hamdam-text still
     clears 4.5:1 comfortably (8.37:1). */
  .journey {
    padding-block: var(--spacing-section-mobile);
    padding-inline: 1.5rem;
    background: linear-gradient(to bottom, var(--arc-forenoon), var(--arc-afternoon));
    color: var(--hamdam-text);
  }
  @media (min-width: 640px) {
    .journey {
      padding-block: var(--spacing-section-desktop);
    }
  }

  .journey__inner {
    max-width: 1200px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .journey__heading {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: 600;
  }
  :global([lang='fa']) .journey__heading {
    font-family: var(--font-farsi);
    font-weight: 500;
  }

  .journey__body {
    margin-top: 1rem;
    font-size: var(--text-body);
    line-height: 1.7;
    max-width: 44rem;
    /* No opacity reduction: --hamdam-text is only 5.13:1 on
       --surface-dawn, and 0.85 opacity measured 4.15:1 (Phase 11/12
       contrast audit) -- below 4.5:1. */
  }

  .journey__frames {
    position: relative;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block-end: 0.5rem;
  }

  .journey__frame {
    all: unset;
    position: relative;
    cursor: pointer;
    flex-shrink: 0;
    width: min(220px, 60vw);
    aspect-ratio: 1290 / 2796;
    scroll-snap-align: center;
    border-radius: var(--radius-device);
    background: linear-gradient(to bottom, var(--surface-dusk), var(--surface-firstlight));
    box-shadow: var(--shadow-rest);
    overflow: hidden;
  }
  .journey__frame:focus-visible {
    /* --color-saffron-ink is tuned for cream; this section sits on
       --surface-dawn, where it measures 1.81:1 (Phase 11/12 contrast
       audit) -- below even the 3:1 non-text minimum a focus ring needs. */
    outline: 2px solid var(--hamdam-text);
    outline-offset: 3px;
  }

  .journey__frame-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .journey__frame-screen {
    /* Explicit width/height, not auto + all four insets: a replaced element
       (img) absolutely positioned with top/right/bottom/left all set and
       width/height auto is over-constrained per the CSS spec's replaced-
       element sizing rules -- browsers resolve it from the image's own
       intrinsic size instead of solving the inset equations, so the insets
       were silently not shrinking the image at all (confirmed live:
       getBoundingClientRect() came back ~equal to the full unshrunk
       container). Explicit width/height removes the ambiguity entirely. */
    position: absolute;
    top: 5.97%;
    left: 6.43%;
    width: 87.5%;
    height: 87.62%;
    object-fit: cover;
    border-radius: 8%;
  }

  .journey__mid-cta {
    margin-top: 3rem;
    text-align: center;
  }
  .journey__mid-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-body);
    margin-bottom: 1rem;
  }
  :global([lang='fa']) .journey__mid-line {
    font-family: var(--font-farsi);
    font-style: normal;
  }

  /* Desktop: copy 40% / pair 60%, frames overlapped ~15%, front swaps on
     hover (150ms z + scale nudge; reduced motion drops the scale). */
  @media (min-width: 1024px) {
    .journey__inner {
      flex-direction: row;
      align-items: center;
    }
    /* The gap is subtracted from the bases (2026-08-14). 40% + 60% is the
       whole row, and .journey__inner then adds a 2.5rem gap on top of it
       with `flex: 0 0`, which forbids either child from shrinking to make
       room -- so the row overflowed its container by exactly the gap. The
       document reported a 1040px scroll width at a 1024px viewport, and the
       same 16px past the edge at 1100. `34-next-steps.md` filed this under
       the poets carousel as "almost certainly pre-existing, worth a glance";
       it is a separate bug from that one and this is the whole of it. */
    .journey__copy {
      flex: 0 0 calc(40% - 1.25rem);
    }
    .journey__frames {
      flex: 0 0 calc(60% - 1.25rem);
      overflow: visible;
      justify-content: center;
      padding-block-end: 0;
    }
    /* Real perspective rather than a flat overlap (2026-08-15). The two frames
       were stacked with a negative margin and a scale on the front one, which
       reads as two stickers rather than as two devices. A shared perspective
       and a small opposed rotation puts them at an angle to each other, so the
       overlap is now occlusion in depth instead of z-index.

       The perspective lives on the container, not the frames, so both share one
       vanishing point -- a per-element `perspective` would give each its own and
       they would not agree. Neither element needs `transform-style: preserve-3d`
       because nothing is nested inside them in 3D; they are leaves, and
       preserve-3d is ignored on them anyway since each clips its screenshot with
       overflow: hidden.

       1400px is deliberately long. A short perspective on an element this size
       distorts the device outline into something no phone looks like, which is
       the failure mode that makes CSS 3D read as a gimmick. */
    .journey__frames {
      perspective: 1400px;
      perspective-origin: 50% 45%;
    }
    .journey__frame {
      width: 240px;
      position: relative;
      transition: transform 150ms var(--ease-cross), box-shadow 150ms var(--ease-cross);
    }
    .journey__frame--reflect {
      margin-inline-end: -60px;
      transform: rotateY(7deg) translateZ(-30px);
    }
    .journey__frame--journey {
      transform: rotateY(-7deg) translateZ(-30px);
    }
    .journey__frame--front {
      z-index: 2;
      box-shadow: var(--shadow-lift);
    }
    /* The frontmost frame turns to face the reader and steps toward them. The
       translateZ is what the scale used to fake: moving 60px closer at this
       perspective grows it by about the same 3% the old scale did, but the edges
       converge correctly on the way instead of the whole bitmap inflating. */
    .journey__frames:not(:hover) .journey__frame--front,
    .journey__frame--front:hover {
      transform: rotateY(0deg) translateZ(30px);
    }
    /* Flat, and the rotations go too -- not just the transition. A static
       rotateY is still a perspective distortion of a photograph of a screen,
       which is exactly what someone asking for reduced motion is asking to be
       spared. */
    @media (prefers-reduced-motion: reduce) {
      .journey__frames {
        perspective: none;
      }
      .journey__frame,
      .journey__frame--reflect,
      .journey__frame--journey {
        transition: none;
        transform: none;
      }
      .journey__frames:not(:hover) .journey__frame--front,
      .journey__frame--front:hover {
        transform: none;
      }
    }
  }
</style>

<script>
  // Frontmost frame swap: pointerenter (desktop hover) and click (mobile
  // tap toggle, page spec §6 item 8) both move --front to the target
  // frame. No scale is driven from JS -- that's CSS-only and already
  // removed under reduced motion.
  const wrap = document.querySelector<HTMLElement>('[data-journey-frames]');
  if (wrap) {
    const frames = Array.from(wrap.querySelectorAll<HTMLElement>('.journey__frame'));
    const bringToFront = (target: HTMLElement) => {
      frames.forEach((f) => f.classList.toggle('journey__frame--front', f === target));
    };
    frames.forEach((frame) => {
      frame.addEventListener('pointerenter', () => bringToFront(frame));
      frame.addEventListener('click', () => bringToFront(frame));
    });
  }
</script>
