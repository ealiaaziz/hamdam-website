---
import { V2_HEADLINE, V2_LEAD, V2_MAJOR, V2_MINOR, V2_UI } from '../data/v2Release';
import { MOMENT_UI } from '../data/momentContent';

// One page body for /v2/ and /fa/v2/, the same single-component shape
// WhatsNewArticle and MomentArticle already use, so the two locales cannot
// drift apart.
//
// WHY THIS PAGE IS NOT /whats-new/. That page publishes what the App Store is
// SERVING, and everything on it is read from the live listing by
// scripts/extract-releases.mjs. Hamdam 2.0 has not shipped, so it has no
// listing, no notes field and no release date, and putting it there would make
// the site claim a version Apple does not have. `npm run check:release` exists
// to catch exactly that and would fail, correctly.
//
// So 2.0 gets its own URL, written in the future tense, with no version number
// reaching any structured data. When 2.0 does ship, its notes join RELEASES
// like every release before it and this page becomes an archive of what was
// promised, which is worth keeping rather than deleting.
//
// PERSIAN. Not one Persian word is authored here. Everything, including the
// headings and the status line, comes from src/data/v2Release.ts, generated by
// scripts/extract-v2-notes.mjs from hamdam-ios docs/app-store/v2-release-notes.md,
// where original Farsi copy is permitted. This is the first page on the site
// whose Farsi half is COMPLETE rather than omitting the chrome it has no
// approved words for, and that is the whole reason the copy was written over
// there instead of here.

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;
const homeHref = lang === 'fa' ? '/fa/' : '/';
const whatsNewHref = lang === 'fa' ? '/fa/whats-new/' : '/whats-new/';

const text = (pair: { en: string; fa: string }) => (lang === 'fa' ? pair.fa : pair.en);
---

<article class="v2">
  <div class="v2__inner">
    <p class="v2__crumb">
      <a href={homeHref}>{MOMENT_UI.home[lang]}</a>
    </p>

    <h1 class="v2__title text-balance">{text(V2_UI.title)}</h1>

    {
      /* The honest line, and it is deliberately the first thing under the
         heading rather than a footnote at the bottom. A page about a version
         nobody can download yet has to say so before it starts describing it. */
    }
    <p class="v2__status">{text(V2_UI.status)}</p>

    <p class="v2__headline text-balance">{text(V2_HEADLINE)}</p>
    <p class="v2__lead">{text(V2_LEAD)}</p>

    <section class="v2__section" aria-labelledby="major">
      <h2 class="v2__section-title" id="major">{text(V2_UI.majorHeading)}</h2>
      <ol class="v2__major">
        {
          V2_MAJOR.map((entry) => (
            <li class="v2__entry">
              <h3 class="v2__entry-title">{lang === 'fa' ? entry.titleFa : entry.titleEn}</h3>
              <p class="v2__entry-body">{text(entry)}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="v2__section" aria-labelledby="minor">
      <h2 class="v2__section-title" id="minor">{text(V2_UI.minorHeading)}</h2>
      <ul class="v2__minor">
        {V2_MINOR.map((line) => <li>{text(line)}</li>)}
      </ul>
    </section>

    <p class="v2__note">
      {text(V2_UI.currentNote)}
      <a href={whatsNewHref}>{text(V2_UI.navLabel)}</a>
    </p>
  </div>
</article>

<style>
  /* Same reading surface as the What's New and moment pages: opens on first
     light and does not move. Both set navOverDarkHero for this reason. */
  .v2 {
    padding-block: 6rem 5rem;
    padding-inline: 1.5rem;
    background:
      radial-gradient(120% 80% at 50% 0%, rgb(240 200 120 / 0.16), transparent 62%),
      linear-gradient(180deg, var(--surface-firstlight), var(--surface-dusk) 62%, var(--surface-night));
    color: var(--text-on-night);
  }
  @media (min-width: 640px) {
    .v2 {
      padding-block: 7.5rem 6rem;
    }
  }

  .v2__inner {
    max-width: 46rem;
    margin-inline: auto;
  }

  .v2__crumb {
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    color: var(--text-on-night-muted);
  }
  :global([lang='fa']) .v2__crumb {
    font-family: var(--font-farsi);
  }
  .v2__crumb a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .v2__crumb a:hover {
    color: var(--text-on-night);
  }

  .v2__title {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 1.1;
  }
  :global([lang='fa']) .v2__title {
    font-family: var(--font-farsi);
    font-size: var(--text-display-fa);
    font-weight: 500;
    line-height: 1.3;
  }

  /* The "not out yet" line. A gold rule on the leading edge rather than a
     coloured pill, so it reads as a note on the page and not as a badge
     advertising something. Inline start, so it moves to the right in Farsi. */
  .v2__status {
    margin-top: 1.25rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 2px solid rgb(240 200 120 / 0.55);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    line-height: 1.7;
    color: var(--text-on-night-muted);
  }
  :global([lang='fa']) .v2__status {
    font-family: var(--font-farsi);
  }

  .v2__headline {
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    line-height: 1.35;
    color: var(--text-on-night);
  }
  :global([lang='fa']) .v2__headline {
    font-family: var(--font-farsi);
    line-height: 1.7;
  }

  .v2__lead {
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--text-on-night-muted);
  }
  :global([lang='fa']) .v2__lead {
    font-family: var(--font-farsi);
    font-size: var(--text-body-fa);
    line-height: 2;
  }

  .v2__section {
    margin-top: 3.5rem;
  }

  .v2__section-title {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: 1.2;
  }
  :global([lang='fa']) .v2__section-title {
    font-family: var(--font-farsi);
    font-weight: 500;
    line-height: 1.5;
  }

  /* The nine big ones, as cards, numbered by the list itself rather than by a
     drawn numeral: the counter sits in the gold node on the leading edge. */
  .v2__major {
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
    counter-reset: v2;
  }

  .v2__entry {
    position: relative;
    counter-increment: v2;
    margin-top: 1rem;
    padding: var(--card-padding-mobile);
    border-radius: var(--radius-panel);
    border: 1px solid rgb(244 237 216 / 0.14);
    background: linear-gradient(180deg, rgb(244 237 216 / 0.09), rgb(244 237 216 / 0.03));
    box-shadow: var(--shadow-lift);
  }
  @media (min-width: 640px) {
    .v2__entry {
      padding: var(--card-padding-desktop);
    }
  }

  .v2__entry-title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--hamdam-night-gold);
  }
  :global([lang='fa']) .v2__entry-title {
    font-family: var(--font-farsi);
    line-height: 1.6;
  }
  .v2__entry-title::before {
    content: counter(v2) '. ';
    opacity: 0.55;
  }
  /* Persian digits on the Persian page. The rest of this page counts in ۰ to ۹,
     including the version number in its own heading, so a Latin numeral in
     front of every entry was the one thing on it still reading left to right.
     `persian` is a predefined CSS counter style, not a string written here. */
  :global([lang='fa']) .v2__entry-title::before {
    content: counter(v2, persian) '. ';
  }

  .v2__entry-body {
    margin-top: 0.85rem;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--text-on-night-muted);
  }
  :global([lang='fa']) .v2__entry-body {
    font-family: var(--font-farsi);
    font-size: var(--text-body-fa);
    line-height: 2;
  }

  /* The smaller ones stay a plain list. They are one line each and a card
     apiece would give thirteen fixes the same weight as the family graph. */
  .v2__minor {
    margin-top: 1.25rem;
    padding-inline-start: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--text-on-night-muted);
  }
  :global([lang='fa']) .v2__minor {
    font-family: var(--font-farsi);
    font-size: var(--text-body-fa);
    line-height: 1.95;
  }
  .v2__minor li::marker {
    color: rgb(240 200 120 / 0.6);
  }

  .v2__note {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(244 237 216 / 0.16);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    line-height: 1.8;
    color: var(--text-on-night-muted);
  }
  :global([lang='fa']) .v2__note {
    font-family: var(--font-farsi);
  }
  .v2__note a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-inline-start: 0.35rem;
    color: var(--hamdam-night-gold);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .v2__note a:hover {
    color: var(--text-on-night);
  }
</style>
