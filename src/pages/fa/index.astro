---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroCinematic from '../../components/HeroCinematic.astro';
import MoodDemo from '../../components/MoodDemo.astro';
import VerseShowcase from '../../components/VerseShowcase.astro';
import { faCopy } from '../../data/siteCopy';
import PoetsBand from '../../components/PoetsBand.astro';
import JourneyPair from '../../components/JourneyPair.astro';
import RootsMoments from '../../components/RootsMoments.astro';
import PrivacyTrust from '../../components/PrivacyTrust.astro';
import PlansAndFoundingCompanion from '../../components/PlansAndFoundingCompanion.astro';
import FinalCeremony from '../../components/FinalCeremony.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import FeatureIcon from '../../components/FeatureIcon.astro';
import HamdamLogotype from '../../components/HamdamLogotype.astro';
import SceneBackground from '../../components/SceneBackground.astro';
import quietGarden from '../../assets/scenes/quiet-garden-section.jpg';
import dawn from '../../assets/scenes/dawn-section.jpg';
import { getImage } from 'astro:assets';
import { homepageSchema } from '../../lib/schema';
import { appStoreUrl } from '../../lib/appStore';
// The Farsi in-app screenshots, matching the EN page's use of the English set.
import heroShot from '../../assets/website-redesign/screenshots/FA/01-today-fa.png';
import reflectShot from '../../assets/website-redesign/screenshots/FA/02-reflect-fa.png';
import wisdomShot from '../../assets/website-redesign/screenshots/FA/03-wisdom-fa.png';
import rootsShot from '../../assets/website-redesign/screenshots/FA/04-roots-fa.png';
import journeyShot from '../../assets/website-redesign/screenshots/FA/05-journey-fa.png';

// Mirrors index.astro's 2026-07-25 restructure to seven sections. Structure
// only: not one Farsi string is authored, rewritten or translated here.
// Two places where this page deliberately does NOT match the English one, both
// for the same reason (no approved Farsi exists, and inventing it is Ealia's
// call, not this session's):
//   1. The hero still leads with the tagline. The English hero now leads with a
//      sentence about what the app does; there is no approved Farsi equivalent.
//   2. The "In your day" grid keeps its five icons. English gained three more
//      (Companions, Calendar, Family Sharing) from the retired companions
//      section, which never existed on this page and has no Farsi labels.
const description =
  'همدم، آینه‌ی قلب و آسمان توست. همراهی روزانه برای تأمل، ریشه‌دار در خرد شعر فارسی. اکنون برای آیفون در دسترس است.';

// Mirrors the EN homepage's SoftwareApplication entity (index.astro) -- the FA
// homepage was previously missing structured data entirely (SEO red-team
// finding, 2026-07-21). name/description reuse copy already shipped and
// Ealia-approved elsewhere on this page (nav aria-label, meta description);
// offers.description is left in English deliberately -- not user-visible
// marketing copy, and this repo's rule bars Claude from authoring or
// translating new Persian copy without Ealia's sign-off.
// Shared builder since 2026-08-07 -- see src/lib/schema.js. `name` and
// `description` still come from this page, so no Persian is authored or
// translated by the move; the machine-readable English fields (featureList,
// offers.description) follow the call already recorded above for
// offers.description.
// getImage, not the raw `.src` -- see the note on index.astro's copy of this.
const screenshots = await Promise.all(
  [heroShot, reflectShot, wisdomShot, rootsShot, journeyShot].map(async (image) => {
    const optimised = await getImage({ src: image, width: 578, format: 'webp', quality: 80 });
    return new URL(optimised.src, Astro.site).href;
  })
);

const jsonLd = homepageSchema({
  lang: 'fa',
  name: 'همدم',
  description,
  url: 'https://hamdam.com.au/fa/',
  downloadUrl: appStoreUrl('fa', null, 'schema'),
  screenshots,
});
---

<BaseLayout
  title="همدم: همراهی برای تأمل روزانه، ریشه‌دار در خرد شعر فارسی"
  description={description}
  lang="fa"
  path="/fa/"
  jsonLd={jsonLd}
>
  {/* 1. HERO */}
  <HeroCinematic lang="fa" title={faCopy.tagline} subhead={faCopy.subhead} />

  {
    /* 2. HOW IT WORKS: demo, then the prose that names it, then what it
       accumulates into. The third paragraph that used to close this block is
       dropped, matching the English page: JourneyPair directly below already
       carries the journal, the favourites and the forgiving streak. Nothing is
       rewritten, only that one approved paragraph is no longer shown twice
       over. */
  }
  <MoodDemo lang="fa" />

  {
    /* Day arc, morning into forenoon -- mirrors the English page exactly.
       Class changes only; the Persian below is untouched generated copy. */
  }
  <section class="section-copy bg-gradient-to-b from-[var(--arc-morning)] to-[var(--arc-forenoon)] px-6 py-[var(--spacing-section-mobile)] sm:py-[var(--spacing-section-desktop)]">
    <div data-reveal class="mx-auto max-w-[var(--container-reading)]">
      <h2 class="text-balance font-farsi text-[length:var(--text-h2)] font-medium text-indigo">
        همدمی برای تأمل روزانه.
      </h2>
      <div class="mt-8 space-y-6 font-farsi text-lg leading-[1.9] text-indigo/90">
        <p>
          همدم هر روز، در همان ساعتی که به سراغت می‌آید، همراهت می‌شود؛ صبحی که به‌آرامی باز
          می‌شود، عصری که آرام می‌کند، شبی که روز را به آرامش می‌رساند. حال دلت را با یک حرکت
          ساده بگو، همدم شعر و تأملی متناسب با آن حس برایت می‌آورد.
        </p>
        {
          /* "در کنار برگردان انگلیسی" (beside the English translation) deleted
             2026-08-16, on Ealia's instruction, as the Farsi mirror of the same
             correction made on the English homepage. The app shows one language
             at a time; see "Verse display" in FACTS.md for the app sources.

             DELETED, NOT REWRITTEN, and the distinction is the whole point. The
             English sentence became "in its original Persian, or in English".
             The equivalent Farsi would have to be authored, and this repo bars
             that, so the clause was removed using only words already in the
             approved sentence and none were added. Every remaining character
             here is from the 2026-07-25 approved copy.

             The cost is that the Farsi homepage no longer mentions that English
             is available at all, where the English one does. That is a real gap
             and it is deliberate: a true sentence that says less beats a false
             one that says more. To restore the parity, Ealia supplies Persian
             meaning "or in English" and it goes back into this sentence. */
        }
        <p>
          هر شعر با متن اصلی پارسی می‌آید، از حافظ، مولانا، سعدی، خیام و پروین اعتصامی.
        </p>
      </div>
    </div>
  </section>

  <JourneyPair lang="fa" />

  <SectionDivider variant="afternoon-lateday" />

  {/* 3. FIVE POETS */}
  <VerseShowcase lang="fa" intro={faCopy.verseIntro} sceneImage={dawn} />

  <SectionDivider variant="goldenhour-dusk" />

  <PoetsBand lang="fa" />

  <SectionDivider variant="dusk-eveplum" />

  {/* 4. ROOTS */}
  <RootsMoments lang="fa" />

  <SectionDivider variant="firstlight-dawn" />

  {/* 5. IN YOUR DAY */}
  <section class="relative bg-gradient-to-b from-[var(--arc-dawn)] to-[var(--arc-sunrise)] px-6 py-[var(--spacing-section-mobile)] text-[var(--hamdam-text)] sm:py-[var(--spacing-section-desktop)]">
    <SceneBackground image={quietGarden} />
    <div data-reveal class="relative mx-auto max-w-[var(--container-reading)]">
      <h2 class="text-balance font-farsi text-[length:var(--text-h2)] font-medium">
        همدم هر جا که نگاه کنی، همراه توست.
      </h2>
      <p class="mt-8 font-farsi text-lg leading-[1.9]">
        از سیری بخواه تأملی را آغاز کند، شعر امروز را بشنود، یا روزشمارت را بررسی کند. ابزارکی به
        صفحه‌ی اصلی اضافه کن. اگر اپل واچ داری، شعر و روزشمارت همراهت سفر می‌کنند. اگر بخواهی، هر
        تأمل می‌تواند به‌عنوان یک ثبت حالت ذهنی در اپل هلث ذخیره شود، همراه با موسیقی آرام از اپل
        موزیک.
      </p>
    </div>
    <div class="relative mx-auto mt-14 flex max-w-2xl flex-wrap justify-center gap-x-10 gap-y-8">
      <FeatureIcon name="siri" label="سیری" lang="fa" />
      <FeatureIcon name="widget" label="ابزارک" lang="fa" />
      <FeatureIcon name="watch" label="اپل واچ" lang="fa" />
      <FeatureIcon name="health" label="اپل هلث" lang="fa" />
      <FeatureIcon name="music" label="اپل موزیک" lang="fa" />
    </div>
  </section>

  {
    /* No divider: this section leaves on the sunrise stop and PrivacyTrust
       enters on it, so the boundary is already continuous. */
  }

  {/* 6. PRIVACY, now carrying the six signals the constellation used to show */}
  <PrivacyTrust lang="fa" />

  {/* 7. PLANS AND CLOSE */}
  <PlansAndFoundingCompanion lang="fa" />
  <FinalCeremony lang="fa" />

  <!-- FOOTER -->
  <footer class="border-t border-saffron/30 px-6 py-20">
    <div class="mx-auto flex max-w-xl flex-col items-center gap-4 text-center">
      <HamdamLogotype size={24} lang="fa" />
      <p class="font-farsi text-sm text-indigo/70">اپلیکیشنی از تیم همدم</p>
      <nav aria-label="Footer" class="flex items-center gap-3 font-farsi text-sm text-indigo/70">
        <a href="/fa/privacy/" class="inline-flex min-h-[44px] items-center px-1 hover:text-indigo">حریم خصوصی</a>
        <span aria-hidden="true">·</span>
        <a href="/fa/terms/" class="inline-flex min-h-[44px] items-center px-1 hover:text-indigo">شرایط استفاده</a>
        <span aria-hidden="true">·</span>
        <a href="mailto:developer@hamdam.com.au" class="inline-flex min-h-[44px] items-center px-1 hover:text-indigo">تماس با ما</a>
      </nav>
      <p class="font-farsi text-sm text-indigo/70">ساخته شده با عشق در بریزبن</p>
      <p class="font-farsi text-xs text-indigo/70">شعرها از گنجور گردآوری شده‌اند.</p>
    </div>
    <div class="mx-auto mt-10 flex max-w-xl flex-col items-center gap-2 border-t border-saffron/20 pt-8 text-center">
      {
        /* S2/S4: matches the shared Footer component exactly. Farsi prose,
           with the legal name, trade mark, application number and support
           address kept Latin-script and LTR in their own spans. */
      }
      {
        /* Brand rather than legal name, mirroring Footer.astro (2026-08-15).
           The Farsi around it is untouched approved copy; only the Latin-script
           span's contents changed. The legal entity still heads the
           business-details block in /fa/privacy/ and /fa/terms/. */
      }
      <p class="font-farsi text-xs text-indigo/70">
        &copy; {new Date().getFullYear()}{' '}
        <span lang="en" dir="ltr" translate="no">Hamdam</span>. همه‌ی حقوق محفوظ است.
      </p>
      <p class="font-farsi text-xs text-indigo/70">
        <span lang="en" dir="ltr">HAMDAM&trade;</span> موضوع درخواست ثبت علامت تجاری در استرالیا
        به شماره‌ی <span lang="en" dir="ltr">2674427</span>، ثبت‌شده در ۱۱ ژوئیه ۲۰۲۶ است.
      </p>
      {
        /* Plain text, not a second small link: تماس با ما above already
           points at this same address with a properly-sized 44px target
           (F7). */
      }
      <p class="font-farsi text-xs text-indigo/70">
        برای پشتیبانی، با <span lang="en" dir="ltr">developer@hamdam.com.au</span> تماس بگیر.
      </p>
    </div>
  </footer>
</BaseLayout>
