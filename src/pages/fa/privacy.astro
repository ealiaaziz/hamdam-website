---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalSection from '../../components/LegalSection.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import Footer from '../../components/Footer.astro';

const effectiveDate = 'تاریخ اجرا: 13 اوت 2026';

const description =
  'همدم چگونه با اطلاعات رفتار می‌کند: به چه چیزی دسترسی دارد، چه چیزی را هرگز جمع‌آوری نمی‌کند، و همگام‌سازی iCloud چگونه کار می‌کند. بدون حساب کاربری، بدون فروش اطلاعات، بدون کوکی‌های ردیابی.';

const jsonLd = {
  '@context': 'https://schema.org',
  // WebPage, not 'PrivacyPolicy'. schema.org has no PrivacyPolicy type and never
  // has: https://schema.org/PrivacyPolicy returns 404, the same as a nonsense
  // string, and it is not in the pending vocabulary either. An unrecognised
  // @type is not an error anyone sees, it just means the entity is silently
  // ignored, so this page published structured data that did nothing. Found
  // 2026-08-21 by resolving every @type on the live site against schema.org
  // rather than by reading it and assuming.
  '@type': 'WebPage',
  name: 'سیاست حریم خصوصی همدم',
  description,
  url: 'https://hamdam.com.au/fa/privacy/',
  datePublished: '2026-07-03',
  dateModified: '2026-08-13',
  publisher: {
    '@type': 'Person',
    name: 'Seyed Valiallah Azizollahi',
  },
};
---

<BaseLayout
  title="حریم خصوصی | همدم"
  description={description}
  lang="fa"
  path="/fa/privacy/"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-[var(--container-reading)] px-6 pb-32 pt-24 sm:pt-[100px] print:pt-8">
    <h1 class="font-farsi text-5xl font-bold text-indigo sm:text-[56px]">حریم خصوصی</h1>
    <p class="mt-3 font-farsi text-sm italic text-indigo/70">{effectiveDate} &middot; زمان مطالعه: حدود 6 دقیقه</p>

    <div class="mt-10 space-y-4 font-farsi text-lg leading-[1.9] text-indigo/90">
      <p>
        همدم اطلاعات تو را جمع‌آوری نمی‌کند. تنها مجموعه‌ی کوچکی از نشانه‌ها را، روی دستگاه خودت،
        می‌بیند تا تأمل امروز را شکل دهد؛ و همان‌جا می‌مانند. هیچ سروری از سوی همدم رفتار تو را زیر
        نظر ندارد، هیچ پروفایلی در پشت صحنه ساخته نمی‌شود، و هیچ‌چیز برای فروش یا معامله جمع‌آوری
        نمی‌شود.
      </p>
      <p>
        این سیاست به‌روشنی توضیح می‌دهد که همدم به چه چیزهایی نگاه می‌کند، چرا، و به چه چیزهایی
        هرگز دست نمی‌زند. این سیاست، اپلیکیشن همدم برای آیفون، آیپد و اپل واچ، و همچنین این وب‌سایت را
        دربرمی‌گیرد.
      </p>
      <p>
        سازنده‌ی همدم، Seyed Valiallah Azizollahi است که با نام Ealia Azizollahi نیز شناخته
        می‌شود. هر دو نام به یک شخص اشاره دارند و هر دو در این سیاست و در شرایط استفاده می‌آیند.
      </p>
    </div>

    <LegalSection heading="1. اطلاعاتی که همدم به آن‌ها دسترسی دارد" lang="fa">
      <p>
        هرکدام از موارد زیر اختیاری است. همدم بدون فعال‌سازی هیچ‌کدام از آن‌ها کار می‌کند؛
        فعال‌کردن هرکدام فقط به آن بخش از تجربه‌ی تأمل اجازه می‌دهد از نشانه‌ی مربوطه استفاده کند.
      </p>

      <h3 class="font-farsi text-xl font-semibold text-indigo">1.1 اطلاعات سلامت (HealthKit)</h3>
      <p>با اجازه‌ی تو، همدم موارد زیر را می‌خواند:</p>
      <ul class="list-disc space-y-1 pr-6">
        <li>ضربان قلب در حالت استراحت و تغییرپذیری ضربان قلب (HRV SDNN)</li>
        <li>تحلیل خواب</li>
        <li>اشباع اکسیژن خون</li>
        <li>تعداد قدم‌ها، دقایق ورزش، و انرژی فعال مصرف‌شده</li>
        <li>جریان قاعدگی، فقط در صورتی که «آگاهی از چرخه» را جداگانه فعال کنی</li>
      </ul>
      <p>
        با اجازه‌ی تو، وقتی ثبت حالت روحی را فعال می‌کنی، همدم رکوردهای «حالت ذهنی» را در اپل هلث
        می‌نویسد. این نشانه‌ها تأمل امروز را به‌شکلی کیفی شکل می‌دهند: یک تلنگر ملایم در لحن،
        نه یک امتیاز یا نمودار. این‌ها روی دستگاه تو باقی می‌مانند. آگاهی از چرخه، جدا از دیگر
        نشانه‌های سلامت، به‌صورت اختیاری فعال می‌شود و هرگز در هیچ‌جای رابط کاربری همدم نمایش داده
        نمی‌شود.
      </p>

      <h3 class="font-farsi text-xl font-semibold text-indigo">1.2 اطلاعات تقویم (EventKit)</h3>
      <p>
        با اجازه‌ی تو، همدم فقط زمان‌های «آزاد/مشغول» را می‌خواند؛ هرگز عنوان رویداد، توضیحات،
        شرکت‌کنندگان، یا مکان را نمی‌خواند. جداگانه، با اجازه‌ی خودش، همدم می‌تواند بلوک‌های تأمل
        اختیاری و یادآوری لحظه‌های فرهنگی را در تقویم تو بنویسد. هر رویدادی که همدم می‌سازد در
        یک تقویم اختصاصی به نام «Hamdam» نوشته می‌شود و با پیشوند «Hamdam:» مشخص می‌شود تا همیشه
        بتوانی آن را تشخیص دهی. همدم رویدادهای خودش را از روی شناسه‌ی همان تقویم می‌شناسد، نه از
        روی تطبیق متن عنوان؛ بنابراین تغییر نام یک رویداد، نه آن را از دسترس همدم خارج می‌کند و نه
        رویدادهای خودت را وارد آن می‌کند. همدم هرگز رویدادی را که خودش نساخته تغییر نمی‌دهد.
        خواندن و نوشتن اطلاعات تقویم، دو فعال‌سازی جداگانه‌اند؛
        فعال‌کردن یکی، دیگری را فعال نمی‌کند.
      </p>

      <h3 class="font-farsi text-xl font-semibold text-indigo">1.3 موقعیت مکانی و آب‌وهوا</h3>
      <p>
        موقعیت مکانی تنها زمانی استفاده می‌شود که ویژگی‌های آب‌وهوا یا لحظه‌های فرهنگی را فعال
        کنی. اطلاعات آب‌وهوا از طریق WeatherKit اپل دریافت می‌شود و از موقعیت تو برای تعیین
        حال‌وهوای تأمل امروز استفاده می‌کند. همدم موقعیت مکانی تو را ذخیره نمی‌کند و آن را با کسی
        به اشتراک نمی‌گذارد.
      </p>

      <h3 class="font-farsi text-xl font-semibold text-indigo">1.4 همگام‌سازی iCloud</h3>
      <p>
        همگام‌سازی iCloud به اشتراک همدم پلاس نیاز دارد. در نسخه‌ی رایگان، اطلاعات تو روی دستگاه
        خودت می‌ماند و هرگز در iCloud نوشته نمی‌شود. اگر پلاس داشته باشی و همگام‌سازی را فعال کنی،
        یادداشت‌ها، شمارنده‌ی روزشمار، و تنظیمات تو از طریق CloudKit
        Private Database اپل، که محدود به Apple ID خودت است، میان دستگاه‌های خودت همگام می‌شوند.
        همدم هیچ سروری اجرا نمی‌کند که این اطلاعات را دریافت کند. اگر اطلاعات iCloud خود را حذف
        کنی یا از آن خارج شوی، اطلاعات همگام‌شده‌ی همدم نیز همراه آن حذف می‌شود.
      </p>

      <h3 class="font-farsi text-xl font-semibold text-indigo">1.5 محتوای شعر فارسی</h3>
      <p>
        شعرهای موجود در همدم، از حافظ، مولانا، سعدی، خیام و پروین اعتصامی، توسط
        همدم گردآوری شده و از منابع دامنه‌ی عمومی از طریق گنجور با ذکر منبع تهیه شده‌اند.
        کتابخانه‌ی اصلی شامل ۲۳۵ شعر است که درون خودِ اپلیکیشن جای دارد و برای خواندن آن به هیچ
        اتصال شبکه‌ای نیاز نیست. جدا از آن، مشترکان همدم پلاس مجموعه‌ای از شعرهای افزوده را
        دریافت می‌کنند که در CloudKit Public Database ذخیره می‌شود و با رشد آن دریافت می‌شود.
        کاربران رایگان هرگز این مجموعه را دریافت نمی‌کنند. همه‌ی این محتوا برای کاربران فقط قابل
        خواندن است و هیچ اطلاعاتی درباره‌ی تو در بر ندارد.
      </p>

      <h3 class="font-farsi text-xl font-semibold text-indigo">1.6 پیشنهادهای بخش کاوش (iTunes Search API)</h3>
      <p>
        بخش «کاوش» همدم روزی یک بار با کتاب‌ها و پادکست‌هایی از کاتالوگ عمومی اپل به‌روزرسانی
        می‌شود. این درخواست‌ها مستقیماً از دستگاه تو به اپل ارسال می‌شوند، هرگز از طریق
        سرور همدم، و هیچ شناسه‌ی مرتبط با تو همراه آن‌ها ارسال نمی‌شود.
      </p>

      <h3 class="font-farsi text-xl font-semibold text-indigo">1.7 تأمل‌های تولیدشده با هوش مصنوعی (Apple Intelligence)</h3>
      <p>
        روی سخت‌افزارهای پشتیبانی‌شده، تأمل‌ها روی خود
        دستگاه و با استفاده از Foundation Models اپل تولید می‌شوند. برای این کار، هیچ متن و هیچ
        اطلاعات شخصی‌ای دستگاه تو را ترک نمی‌کند. روی دستگاه‌های پشتیبانی‌نشده، همدم از یک
        کتابخانه‌ی محتوای از پیش نوشته‌شده و ثابت استفاده می‌کند.
      </p>
    </LegalSection>

    <SectionDivider />

    <LegalSection heading="2. آنچه همدم جمع‌آوری نمی‌کند" lang="fa">
      <ul class="list-disc space-y-1 pr-6">
        <li>بدون حساب کاربری، و بدون جمع‌آوری ایمیل هنگام ثبت‌نام</li>
        <li>بدون SDK اختصاصی گزارش خرابی یا آمارگیری. تنها اطلاعات خرابی جمع‌آوری‌شده،
        گزارش خرابی داخلی خود iOS از طریق App Store Connect است که به‌صورت تجمیعی و ناشناس
        است</li>
        <li>بدون SDK تبلیغاتی: بدون AdMob، Meta Pixel، یا پیکسل‌های ردیابی</li>
        <li>بدون ردیابی رفتاری و بدون پروفایل‌سازی کاربر</li>
        <li>هرگز فروش اطلاعات</li>
        <li>بدون سرور بک‌اند متعلق به همدم که اطلاعات کاربر را دریافت کند</li>
        <li>بدون خبرنامه و بدون اتوماسیون بازاریابی</li>
        <li>بدون ردیابی میان‌برنامه‌ای</li>
        <li>بدون SDK که از طرف همدم اطلاعات شخصی جمع‌آوری کند</li>
        <li>بدون کوکی، چون این وب‌سایت کاملاً استاتیک است</li>
        <li>بدون بارگذاری فونت از منابع شخص ثالث: فونت‌ها به‌صورت محلی میزبانی می‌شوند و
        هیچ درخواستی به Google Fonts یا هر CDN فونت دیگری ارسال نمی‌شود</li>
      </ul>

      <h3 class="font-farsi text-xl font-semibold text-indigo">2.1 آنچه این وب‌سایت جمع‌آوری می‌کند</h3>
      <p>
        این وب‌سایت از Cloudflare Web Analytics برای شمارش بازدید صفحه‌ها استفاده می‌کند. تنها
        شمارش کلی و بدون کوکی ثبت می‌شود. هیچ کوکی‌ای گذاشته نمی‌شود، تو را میان سایت‌های مختلف
        ردیابی نمی‌کند، و نمی‌تواند هویت تو را تشخیص دهد. همدم از هیچ‌کدام از Firebase، Mixpanel،
        Amplitude یا Google Analytics استفاده نمی‌کند.
      </p>
      <p>
        این تنها درباره‌ی وب‌سایت است. خودِ اپلیکیشن همدم هیچ‌گونه آمارگیری ندارد.
      </p>
    </LegalSection>

    <LegalSection heading="3. چگونگی استفاده از اطلاعات تو" lang="fa">
      <p>نشانه‌های توضیح‌داده‌شده در بخش 1، در صورتی که فعال کرده باشی، فقط برای موارد زیر استفاده می‌شوند:</p>
      <ul class="list-disc space-y-1 pr-6">
        <li>شکل‌دادن به لحن و محتوای تأمل امروز</li>
      </ul>
      <p>هرگز برای موارد زیر استفاده نمی‌شوند:</p>
      <ul class="list-disc space-y-1 pr-6">
        <li>برای تبلیغات</li>
        <li>برای آموزش مدل‌های هوش مصنوعی خارج از دستگاه تو</li>
        <li>اشتراک‌گذاری با اشخاص ثالث</li>
        <li>فروش، تحت هیچ شرایطی</li>
      </ul>
    </LegalSection>

    <LegalSection heading="4. ذخیره‌سازی و نگهداری اطلاعات" lang="fa">
      <ul class="list-disc space-y-1 pr-6">
        <li>به‌صورت محلی، روی دستگاه تو، با استفاده از فریم‌ورک SwiftData اپل</li>
        <li>در فضای ابری، فقط در حساب iCloud خودت، در صورت فعال‌بودن همگام‌سازی</li>
        <li>هرگز روی سروری متعلق به همدم</li>
      </ul>
      <p>اطلاعات تا زمانی که آن را در اپلیکیشن حذف کنی یا همدم را حذف نصب کنی، نگهداری می‌شود.</p>
    </LegalSection>

    <LegalSection heading="5. خدمات شخص ثالث" lang="fa">
      <p>
        همدم بر پایه‌ی فریم‌ورک‌های اپل ساخته شده است: iCloud، HealthKit، EventKit، WeatherKit،
        StoreKit، MusicKit (اپل موزیک)، و Foundation Models. سیاست‌های حریم خصوصی خود اپل، نحوه‌ی
        مدیریت اطلاعات توسط این فریم‌ورک‌ها را در سمت اپل تعیین می‌کند. گنجور به‌عنوان منبع دامنه‌ی
        عمومی متن اشعار فارسی ذکر شده است. هیچ اطلاعاتی در زمان اجرا با گنجور مبادله
        نمی‌شود. iTunes Search API یک رابط برنامه‌نویسی عمومی اپل است که مستقیماً از دستگاه تو
        فراخوانی می‌شود. دو مورد از این فریم‌ورک‌ها هنگام نمایش، تصویر هم می‌گیرند: کاور آهنگ در
        پخش‌کننده‌ی کوچک اپل موزیک، و نشان منبع WeatherKit که کنار پیش‌بینی آب‌وهوا نشان داده
        می‌شود. هر دو از سرورهای خود اپل می‌آیند.
      </p>
      <p>
        همدم زندگی‌نامه‌ی شاعران و توضیح نشانه‌های فرهنگی را از رابط برنامه‌نویسی ویکی‌پدیا
        (en.wikipedia.org) و تصویرهای مربوط به آن‌ها را از upload.wikimedia.org می‌خواند. دستگاه
        تو تنها عنوان صفحه‌ای را که جست‌وجو می‌شود می‌فرستد. هیچ اطلاعاتی درباره‌ی تو، تأملات تو،
        یا سلامت تو در این درخواست‌ها نیست.
      </p>
      <p>
        کارت‌های نشانه‌های فرهنگی در «ریشه‌ها» هرکدام عکسی را نشان می‌دهند که همدم اجازه‌ی نمایش
        آن را دارد، و پیدا کردن چنین عکسی دستگاه تو را به چند سرویس مرجع می‌برد. نخست از
        <strong>www.wikidata.org</strong> می‌پرسد که برای آن موضوع چه تصویری ثبت شده است، با
        شناسه‌ای ثابت که داخل خود برنامه قرار دارد. سپس از
        <strong>commons.wikimedia.org</strong> پروانه و اطلاعات منبع آن تصویر را می‌خواهد، چون
        نمایش قانونی یک عکس بدون آن‌ها ممکن نیست، و خود تصویر را از upload.wikimedia.org
        بارگذاری می‌کند. اگر ویکی‌مدیا چیزی نداشته باشد که همدم اجازه‌ی استفاده از آن را داشته
        باشد، همان موضوع را با نام علمی‌اش از <strong>api.inaturalist.org</strong> می‌پرسد و عکس
        به‌دست‌آمده را از <strong>inaturalist-open-data.s3.amazonaws.com</strong> می‌گیرد، جایی
        که iNaturalist تصویرهای داده‌ی باز خود را ارائه می‌کند. هر مقداری که فرستاده می‌شود یک
        شناسه‌ی ثابت یا یک نام گونه است که داخل خود برنامه قرار دارد. هیچ اطلاعاتی درباره‌ی تو،
        تأملات تو، دفترچه‌ی تو، یا سلامت تو در آن نیست، و هیچ حساب کاربری یا شناسه‌ی دستگاهی به
        آن پیوست نمی‌شود.
      </p>
      <p>
        <strong>Nager.Date (date.nager.at)</strong> تاریخ تعطیلات رسمی را فراهم می‌کند تا گاه‌شمار «ریشه‌ها»
        بتواند روزهای مهمِ جایی که در آن زندگی می‌کنی را نشان دهد. دستگاه تو تنها یک کد کشور و یک
        سال تقویمی می‌فرستد و نه چیز دیگری. کد کشور روی دستگاه خودت و از همان اجازه‌ی موقعیت
        مکانی که پیش‌تر برای آب‌وهوا داده‌ای به دست می‌آید؛ مختصات تو هرگز به Nager.Date فرستاده
        نمی‌شود. این درخواست هیچ حساب کاربری، هیچ شناسه‌ی دستگاه، و هیچ اطلاعات شخصی به همراه
        ندارد، و همدم دست‌بالا سالی یک بار آن را به‌روز می‌کند.
      </p>
      <p>
