---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MomentArticle from '../../components/MomentArticle.astro';
import Footer from '../../components/Footer.astro';
import { ROOTS_MOMENTS } from '../../data/rootsMoments';
import { getBrisbaneToday } from '../../lib/countdown';
import { formatMomentDate, upcomingOccurrences } from '../../lib/momentText';
import {
  MOMENT_COPY,
  MOMENT_PAGE_IDS,
  MOMENT_SLUGS,
  MOMENT_TITLE_TAIL_EN,
} from '../../data/momentContent';
import { momentPageSchema } from '../../lib/schema';

// The English half of the cultural moment cluster, built 2026-08-07. The Farsi
// half is src/pages/fa/moments/[moment].astro and is generated from the same
// component and the same data, so the two cannot drift.
//
// Slugs are Latin and identical on both locales, which means switchLocalePath
// maps /moments/yalda/ to /fa/moments/yalda/ with no per-locale slug table,
// and BaseLayout's hreflang pair is correct without any change to it.
export function getStaticPaths() {
  return MOMENT_PAGE_IDS.map((id) => ({
    params: { moment: MOMENT_SLUGS[id] },
    props: { momentId: id },
  }));
}

const { momentId } = Astro.props;
const moment = ROOTS_MOMENTS.find((m) => m.id === momentId)!;
const path = `/moments/${MOMENT_SLUGS[momentId]}/`;

// The snippet leads with the date, because the date is what the winning query
// asks for.
//
// The 2026-09-03 Search Console reading has this page at average position 5.9
// on 14 impressions with no clicks, and the named query driving it is
// `yalda 2026`. Somebody typing a year wants to know when the night falls. The
// page body has answered that since it was built, computed from the Persian
// calendar rule in rootsMoments; the title and description never carried it,
// so the one line a searcher reads before deciding to click did not answer
// the question they asked.
//
// The date is the next occurrence, computed at build time from the same
// `upcomingOccurrences` call the article body renders, so it rolls forward on
// its own and no year is ever typed into this file. The occurrence list is
// short by design for moments whose dates are only banked for the years the
// app shipped with, so an empty list falls back to exactly the previous title
// and description rather than printing a half sentence.
//
// The approved sentence is kept verbatim after the date, unchanged. It is
// still the best description of the moment this project has, it is signed off,
// and a visitor arriving from the snippet still reads the same words on the
// page.
const nextOccurrence = upcomingOccurrences(moment.rule, getBrisbaneToday(), 1)[0] ?? null;
const nextDate = nextOccurrence ? formatMomentDate('en', nextOccurrence.date) : null;

const snippet = MOMENT_COPY[momentId].snippetEn ?? MOMENT_COPY[momentId].sentenceEn;
const description = nextDate ? `${moment.nameEn} falls on ${nextDate}. ${snippet}` : snippet;
const title = nextOccurrence
  ? `${moment.nameEn} ${nextOccurrence.date.year}: ${MOMENT_TITLE_TAIL_EN[momentId]} | Hamdam`
  : `${moment.nameEn}: ${MOMENT_TITLE_TAIL_EN[momentId]} | Hamdam`;

const jsonLd = momentPageSchema({
  lang: 'en',
  name: moment.nameEn,
  description,
  url: new URL(path, Astro.site).href,
  breadcrumbHome: 'Hamdam',
  homeUrl: new URL('/', Astro.site).href,
});
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  path={path}
  jsonLd={jsonLd}
  navOverDarkHero={true}
>
  <MomentArticle lang="en" momentId={momentId} />
  <Footer lang="en" />
</BaseLayout>
