---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MomentArticle from '../../components/MomentArticle.astro';
import Footer from '../../components/Footer.astro';
import { ROOTS_MOMENTS } from '../../data/rootsMoments';
import {
  MOMENT_COPY,
  MOMENT_PAGE_IDS,
  MOMENT_SLUGS,
  MOMENT_TITLE_TAIL_EN,
} from '../../data/momentContent';
import { momentPageSchema } from '../../lib/schema';

// The English half of the cultural moment cluster, built 2026-08-07. The Farsi
// half is src/pages/fa/moments/[moment].astro and is generated from the same
// component and the same data, so the two cannot drift.
//
// Slugs are Latin and identical on both locales, which means switchLocalePath
// maps /moments/yalda/ to /fa/moments/yalda/ with no per-locale slug table,
// and BaseLayout's hreflang pair is correct without any change to it.
export function getStaticPaths() {
  return MOMENT_PAGE_IDS.map((id) => ({
    params: { moment: MOMENT_SLUGS[id] },
    props: { momentId: id },
  }));
}

const { momentId } = Astro.props;
const moment = ROOTS_MOMENTS.find((m) => m.id === momentId)!;
const path = `/moments/${MOMENT_SLUGS[momentId]}/`;

// The meta description is the approved sentence, verbatim. It is the best
// description of the moment this project has, it is already signed off, and
// using it means the snippet a search engine shows is the same sentence a
// visitor then reads.
const description = MOMENT_COPY[momentId].sentenceEn;
const title = `${moment.nameEn}: ${MOMENT_TITLE_TAIL_EN[momentId]} | Hamdam`;

const jsonLd = momentPageSchema({
  lang: 'en',
  name: moment.nameEn,
  description,
  url: new URL(path, Astro.site).href,
  breadcrumbHome: 'Hamdam',
  homeUrl: new URL('/', Astro.site).href,
});
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  path={path}
  jsonLd={jsonLd}
  navOverDarkHero={true}
>
  <MomentArticle lang="en" momentId={momentId} />
  <Footer lang="en" />
</BaseLayout>
