---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCinematic from '../components/HeroCinematic.astro';
import MoodDemo from '../components/MoodDemo.astro';
import VerseShowcase from '../components/VerseShowcase.astro';
import PoetsBand from '../components/PoetsBand.astro';
import JourneyPair from '../components/JourneyPair.astro';
import GardenSection from '../components/GardenSection.astro';
import RootsMoments from '../components/RootsMoments.astro';
import PrivacyTrust from '../components/PrivacyTrust.astro';
import PlansAndFoundingCompanion from '../components/PlansAndFoundingCompanion.astro';
import FinalCeremony from '../components/FinalCeremony.astro';
import SectionDivider from '../components/SectionDivider.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import Footer from '../components/Footer.astro';
import SceneBackground from '../components/SceneBackground.astro';
import quietGarden from '../assets/scenes/quiet-garden-section.jpg';
import dawn from '../assets/scenes/dawn-section.jpg';
import { getImage } from 'astro:assets';
import { homepageSchema } from '../lib/schema';
import { appStoreUrl } from '../lib/appStore';
// Real in-app screenshots, the same files the page already renders in its
// device frames -- schema.org/screenshot must point at the actual app, not at
// the OG artwork.
import heroShot from '../assets/website-redesign/screenshots/EN/01-today-en.png';
import reflectShot from '../assets/website-redesign/screenshots/EN/02-reflect-en.png';
import wisdomShot from '../assets/website-redesign/screenshots/EN/03-wisdom-en.png';
import rootsShot from '../assets/website-redesign/screenshots/EN/04-roots-en.png';
import journeyShot from '../assets/website-redesign/screenshots/EN/05-journey-en.png';

// Restructured 2026-07-25 from thirteen stacked sections to seven. Two things
// were wrong with the old page: it was too long, and it took several screens to
// say what the app does. The seven are Hero, How it works, Five poets, Roots,
// In your day, Privacy, Plans and close. ContextConstellation is folded into
// Privacy (its six signals are privacy claims), "quiet companions" into In your
// day, and "Hamdam is still becoming" is retired outright. All three were DRAFT
// copy per their own comments, so no approved copy is lost. Ealia signed off on
// this structure and on the English copy below, 2026-07-25. None of the
// component files are deleted, so this is revertible per
// docs/website-redesign/27-release-and-rollback-plan.md.
//
// Rewritten 2026-07-25, approved by Ealia the same day: the previous
// description ("grounded in Persian poetic wisdom") read as diaspora-only,
// while the app itself resolves content per user and Roots now carries the days
// that matter wherever you are from. The FA page's description is unchanged:
// rewriting it would mean authoring new Persian.
// E1, 2026-07-28: the title carries the SEO weight and previously held no
// poet names, which are the higher-volume search terms. Hafez and Rumi are now
// in the description, and the title matches the new App Store name. The h1 is
// deliberately untouched: it carries no keywords and it is the best sentence
// on the site.
// Shortened 2026-09-05 from 189 characters. Google truncates a snippet by
// rendered width, and at 189 the clause that got cut was "Available now on
// iPhone and iPad" -- the call to action. The five poet names stay: they are
// what the page is about and what people search for.
const description =
  "A daily verse from Hafez, Rumi, Saadi, Khayyam or Parvin Etesami, with a reflection chosen for how your day feels. Free on iPhone and iPad.";

// Structured data moved to src/lib/schema.js on 2026-08-07 (SEO audit): both
// homepages hand-maintained the same object and both published
// `operatingSystem: 'iOS 26+'` while that number was unverified. Read that
// file's header before changing the OS string or adding a rating.
// getImage rather than the raw `.src`: referencing the import directly makes
// Astro emit the untouched PNGs alongside the webp the page already renders,
// which added 22MB to dist for five images nobody downloads. These resolve to
// the optimised assets instead.
const screenshots = await Promise.all(
  [heroShot, reflectShot, wisdomShot, rootsShot, journeyShot].map(async (image) => {
    const optimised = await getImage({ src: image, width: 578, format: 'webp', quality: 80 });
    return new URL(optimised.src, Astro.site).href;
  })
);

const jsonLd = homepageSchema({
  lang: 'en',
  name: 'Hamdam',
  description,
  url: 'https://hamdam.com.au/',
  downloadUrl: appStoreUrl('en', null, 'schema'),
  screenshots,
});
---

<BaseLayout
  title="Hamdam: Daily Persian Poetry, Reflection and Journal"
  description={description}
  lang="en"
  path="/"
  preloadFarsiVerse={true}
  jsonLd={jsonLd}
>
  {
    /* 1. HERO
       Leads with what the app does, not the brand line. The tagline is still
       here, demoted to the subhead, which keeps the approved sentence on the
       page while the first thing a visitor reads is the function. Approved by
       Ealia 2026-07-25.

       One word added 2026-08-16, on Ealia's instruction, for search: the
       sentence carried no category term at all, so the page's most weighted
       heading said nothing about Persian poetry.

       "Persian" rather than a longer prefix, and the reason is measured, not
       aesthetic. The candidate that scored best on paper was "Daily Persian
       poetry: a verse and a reflection, chosen for how your day feels.", which
       carries more terms and matches the <title> and the AU App Store name
       exactly, and it was tried first. It renders at six lines at 1440x900
       against this sentence's four, which pushes the subhead from y=620 to
       y=760 -- into the mountain silhouette, where it is unreadable. The hero
       is a fixed-height cinematic composition, so H1 length is a layout
       constraint here and not just a copy choice. Measured at 390x844 and
       1440x900 before choosing; screenshots in the PR.

       This costs one word of the approved 2026-07-25 sentence ("A verse" ->
       "A Persian verse") and nothing else. The Farsi H1 is untouched and
       correctly so -- it comes from `faCopy.tagline`, is generated rather than
       authored here, and its own title already leads with the category. */
  }
  <HeroCinematic
    lang="en"
    title="A Persian verse and a reflection, chosen for how your day feels."
    subhead="Hamdam reflects your heart and your sky."
  />

  {
    /* 2. HOW IT WORKS
       MoodDemo shows the mechanism, the prose names it, JourneyPair shows what
       it accumulates into. No divider between the three: they are one argument.
       The old third paragraph here ("A gentle streak keeps count...") is gone,
       not lost: JourneyPair now sits directly below and says the same thing. */
  }
  <MoodDemo lang="en" />

  {
    /* First step of the day arc's descent (2026-08-14). The section's own
       words are what the whole arc is built on -- "a morning that opens
       gently, an afternoon that steadies, an evening that settles" -- so it
       starts in the morning the hero resolves to and leaves on forenoon,
       and the page carries on falling from there. Padding evened up at the
       same time: pt-8/pb-4 against the 90/140px every other section uses
       left a ~250px hole above this heading and none below it. */
  }
  <section class="section-copy bg-gradient-to-b from-[var(--arc-morning)] to-[var(--arc-forenoon)] px-6 py-[var(--spacing-section-mobile)] sm:py-[var(--spacing-section-desktop)]">
    <div data-reveal class="mx-auto max-w-[var(--container-reading)]">
      <h2 class="text-balance font-serif text-[length:var(--text-h2)] font-semibold text-indigo">
        A companion for the daily reflection.
      </h2>
      <div class="mt-8 space-y-6 font-serif text-xl leading-[1.7] text-indigo/90">
        <p>
          Every day, Hamdam meets you at the hour it finds you: a morning that opens gently, an
          afternoon that steadies, an evening that settles. Tell it how your heart feels with a
          simple slider, and it offers a verse and a reflection chosen for that feeling.
        </p>
        {
          /* "careful" removed 2026-08-07, on Ealia's instruction. FACTS.md
             marks any claim about translation quality or provenance CONTESTED
             with a hard block, because the app still ships AI-generated
             English while publicly committing to cited public domain sources
             (Nicholson, Whinfield, Bell). Restore an adjective here only once
             the replacement translations have shipped and FACTS.md records
             them as VERIFIED.

             "beside" -> "or in" 2026-08-16, on Ealia's instruction. This
             comment used to end by asserting that "the presentation claim, a
             Persian original beside an English translation, is true today".
             It was not true, and had never been checked: the app shows one
             language at a time, whichever the app is set to, on every primary
             surface. Read out of hamdam-ios @ 820270c -- see "Verse display"
             in FACTS.md for the file-and-line sources.

             The same sentence stood in five places and this comment was the
             written justification for all of them, which is the reason to
             correct it here rather than delete it: a future reader who finds
             only the new wording should be able to see that the old one was
             checked and failed, not quietly restyled. */
        }
        <p>
          Every verse arrives in its original Persian, or in English, drawn from Hafez, Rumi,
          Saadi, Khayyam and Parvin Etesami. Open it further and the whole poem unfolds around
          the line you were given, its themes named beneath it. Many verses can be heard as well
          as read, in the voice of a named Persian reciter.
        </p>
        {
          /* The Garden's paragraph used to sit here, added 2026-08-27 with
             version 1.3 and moved out the same day. It was accurate and it was
             the third paragraph of a prose block, which is how the largest
             feature in the release ended up invisible: Ealia's report was "I
             can't see anything about garden" while every word of it was live.
             It is now <GardenSection>, below JourneyPair, with a screenshot.
             The wording, the sources and the two traps that paragraph recorded
             (one language at a time, "many verses" and not "every verse") are
             carried in that component's header and in FACTS.md. */
        }
      </div>
    </div>
  </section>

  <JourneyPair lang="en" />

  {
    /* The Garden (2026-08-27). It sits on the arc step the
       `afternoon-lateday` divider used to cross by itself, and replaces it:
       that divider was 220px of gradient carrying nothing, added only because
       no section spanned the gap. One that does is a better bridge. /fa/ still
       has the divider, because the section is English-only until a Farsi
       capture of the Garden screen exists -- see GardenSection.astro. */
  }
  <GardenSection lang="en" />

  {
    /* 3. FIVE POETS
       VerseShowcase is in neither the target structure nor the retire list in
       the handoff, and it carries approved verse content, so it joins the poets
       rather than being dropped: the verse and the five voices behind it are
       one section. Flagged as a judgement call. */
  }
  <VerseShowcase
    lang="en"
    intro="A verse for every morning. Five poets. In Persian or English. Centuries of wisdom."
    sceneImage={dawn}
  />

  {
    /* The descent into evening. This boundary had no divider at all and it
       is the largest tonal step on the page -- golden hour to the poets'
       night -- so it gets the tall bridge, and the crossing happens where
       there is no text to be illegible on. */
  }
  <SectionDivider variant="goldenhour-dusk" />

  <PoetsBand lang="en" />

  <SectionDivider variant="dusk-eveplum" />

  {/* 4. ROOTS */}
  <RootsMoments lang="en" />

  <SectionDivider variant="firstlight-dawn" />

  {
    /* 5. IN YOUR DAY
       The old "meets you wherever you look" section and the "quiet companions"
       section were the same section: everything Hamdam touches outside its own
       screens. One heading, one grid of eight. The companions prose is retired
       (DRAFT), but its one load-bearing claim, that all of this is optional and
       off until asked for, is kept below in a single sentence. Approved by Ealia
       2026-07-25. */
  }
  {
    /* Dawn into sunrise (2026-08-14). This section used to be cream with a
       peach wash, sitting between the plum Roots slab and the ember privacy
       slab -- the last of the bright stripes. It is now the first section
       after the arc climbs back out of the dead zone, so it carries dark
       text on a warm ground: --hamdam-text measures 5.13:1 at the dawn end
       and 7.36:1 at the sunrise end. The secondary paragraph below keeps the
       same colour at a smaller size rather than dropping to indigo/70, which
       fails outright on both (2.6:1 and 3.4:1). */
  }
  <section class="relative bg-gradient-to-b from-[var(--arc-dawn)] to-[var(--arc-sunrise)] px-6 py-[var(--spacing-section-mobile)] text-[var(--hamdam-text)] sm:py-[var(--spacing-section-desktop)]">
    <SceneBackground image={quietGarden} />
    <div data-reveal class="relative mx-auto max-w-[var(--container-reading)]">
      <h2 class="text-balance font-serif text-[length:var(--text-h2)] font-semibold">
        Hamdam meets you wherever you look.
      </h2>
      <p class="mt-8 font-serif text-xl leading-[1.7]">
        Ask Siri to start a reflection, hear today's verse, or check your streak. Add a widget to
        your Home Screen. If you wear an Apple Watch, your verse and streak travel with you. If
        you choose, each reflection can be saved to Apple Health as a State of Mind entry, with
        calm music playing alongside through Apple Music.
      </p>
      <p class="mt-6 font-serif text-lg leading-[1.7]">
        The companions, the calendar and Family Sharing are all optional, and each stays off
        until you ask for it.
      </p>
    </div>
    {
      /* Four and four, not a wrapping row (2026-08-14). Eight icons in a
         flex-wrap at this measure broke 6 + 2, leaving an orphaned pair
         under a full row. A fixed 4-column grid at tablet and up makes the
         same eight read as two deliberate rows; below that it is 2 x 4. */
    }
    <div class="relative mx-auto mt-14 grid max-w-2xl grid-cols-2 justify-items-center gap-x-10 gap-y-8 sm:grid-cols-4">
      <FeatureIcon name="siri" label="Siri" />
      <FeatureIcon name="widget" label="Widgets" />
      <FeatureIcon name="watch" label="Watch" />
      <FeatureIcon name="health" label="Health" />
      <FeatureIcon name="music" label="Music" />
      <FeatureIcon name="companion" label="Companions" />
      <FeatureIcon name="calendar" label="Calendar" />
      <FeatureIcon name="family" label="Family Sharing" />
    </div>
  </section>

  {
    /* No divider here any more: this section leaves on the sunrise stop and
       PrivacyTrust enters on it, so the boundary is already continuous and a
       bridge would have nothing to bridge. */
  }

  {/* 6. PRIVACY, now carrying the six signals the constellation used to show */}
  <PrivacyTrust lang="en" />

  {/* 7. PLANS AND CLOSE: one continuous ending, no divider between them */}
  <PlansAndFoundingCompanion lang="en" />
  <FinalCeremony lang="en" />

  <Footer />
</BaseLayout>
