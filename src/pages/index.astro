---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCinematic from '../components/HeroCinematic.astro';
import MoodDemo from '../components/MoodDemo.astro';
import VerseShowcase from '../components/VerseShowcase.astro';
import PoetsBand from '../components/PoetsBand.astro';
import JourneyPair from '../components/JourneyPair.astro';
import RootsMoments from '../components/RootsMoments.astro';
import PrivacyTrust from '../components/PrivacyTrust.astro';
import PlansAndFoundingCompanion from '../components/PlansAndFoundingCompanion.astro';
import FinalCeremony from '../components/FinalCeremony.astro';
import SectionDivider from '../components/SectionDivider.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import Footer from '../components/Footer.astro';
import SceneBackground from '../components/SceneBackground.astro';
import quietGarden from '../assets/scenes/quiet-garden-section.jpg';
import dawn from '../assets/scenes/dawn-section.jpg';
import { getImage } from 'astro:assets';
import { homepageSchema } from '../lib/schema';
import { appStoreUrl } from '../lib/appStore';
// Real in-app screenshots, the same files the page already renders in its
// device frames -- schema.org/screenshot must point at the actual app, not at
// the OG artwork.
import heroShot from '../assets/website-redesign/screenshots/EN/01-hero-en.png';
import reflectShot from '../assets/website-redesign/screenshots/EN/02-reflect-en.png';
import wisdomShot from '../assets/website-redesign/screenshots/EN/03-wisdom-en.png';
import rootsShot from '../assets/website-redesign/screenshots/EN/04-roots-en.png';
import journeyShot from '../assets/website-redesign/screenshots/EN/05-journey-en.png';

// Restructured 2026-07-25 from thirteen stacked sections to seven. Two things
// were wrong with the old page: it was too long, and it took several screens to
// say what the app does. The seven are Hero, How it works, Five poets, Roots,
// In your day, Privacy, Plans and close. ContextConstellation is folded into
// Privacy (its six signals are privacy claims), "quiet companions" into In your
// day, and "Hamdam is still becoming" is retired outright. All three were DRAFT
// copy per their own comments, so no approved copy is lost. Ealia signed off on
// this structure and on the English copy below, 2026-07-25. None of the
// component files are deleted, so this is revertible per
// docs/website-redesign/27-release-and-rollback-plan.md.
//
// Rewritten 2026-07-25, approved by Ealia the same day: the previous
// description ("grounded in Persian poetic wisdom") read as diaspora-only,
// while the app itself resolves content per user and Roots now carries the days
// that matter wherever you are from. The FA page's description is unchanged:
// rewriting it would mean authoring new Persian.
// E1, 2026-07-28: the title carries the SEO weight and previously held no
// poet names, which are the higher-volume search terms. Hafez and Rumi are now
// in the description, and the title matches the new App Store name. The h1 is
// deliberately untouched: it carries no keywords and it is the best sentence
// on the site.
const description =
  "Hamdam reflects your heart and your sky. A daily verse from Hafez, Rumi, Saadi, Khayyam or Parvin Etesami, with a reflection chosen for how your day feels. Available now on iPhone.";

// Structured data moved to src/lib/schema.js on 2026-08-07 (SEO audit): both
// homepages hand-maintained the same object and both published
// `operatingSystem: 'iOS 26+'`, the accidental deployment target. Read that
// file's header before changing the OS string or adding a rating.
// getImage rather than the raw `.src`: referencing the import directly makes
// Astro emit the untouched PNGs alongside the webp the page already renders,
// which added 22MB to dist for five images nobody downloads. These resolve to
// the optimised assets instead.
const screenshots = await Promise.all(
  [heroShot, reflectShot, wisdomShot, rootsShot, journeyShot].map(async (image) => {
    const optimised = await getImage({ src: image, width: 578, format: 'webp', quality: 80 });
    return new URL(optimised.src, Astro.site).href;
  })
);

const jsonLd = homepageSchema({
  lang: 'en',
  name: 'Hamdam',
  description,
  url: 'https://hamdam.com.au/',
  downloadUrl: appStoreUrl('en', null, 'schema'),
  screenshots,
});
---

<BaseLayout
  title="Hamdam: Daily Persian Poetry, Reflection and Journal"
  description={description}
  lang="en"
  path="/"
  preloadFarsiVerse={true}
  jsonLd={jsonLd}
>
  {
    /* 1. HERO
       Leads with what the app does, not the brand line. The tagline is still
       here, demoted to the subhead, which keeps the approved sentence on the
       page while the first thing a visitor reads is the function. Approved by
       Ealia 2026-07-25. */
  }
  <HeroCinematic
    lang="en"
    title="A verse and a reflection, chosen for how your day feels."
    subhead="Hamdam reflects your heart and your sky."
  />

  {
    /* 2. HOW IT WORKS
       MoodDemo shows the mechanism, the prose names it, JourneyPair shows what
       it accumulates into. No divider between the three: they are one argument.
       The old third paragraph here ("A gentle streak keeps count...") is gone,
       not lost: JourneyPair now sits directly below and says the same thing. */
  }
  <MoodDemo lang="en" />

  <section class="px-6 pb-4 pt-8 sm:pb-8 sm:pt-12">
    <div data-reveal class="mx-auto max-w-[var(--container-reading)]">
      <h2 class="text-balance font-serif text-4xl font-semibold text-indigo sm:text-5xl">
        A companion for the daily reflection.
      </h2>
      <div class="mt-8 space-y-6 font-serif text-xl leading-[1.7] text-indigo/90">
        <p>
          Every day, Hamdam meets you at the hour it finds you: a morning that opens gently, an
          afternoon that steadies, an evening that settles. Tell it how your heart feels with a
          simple slider, and it offers a verse and a reflection chosen for that feeling.
        </p>
        {
          /* "careful" removed 2026-08-07, on Ealia's instruction. FACTS.md
             marks any claim about translation quality or provenance CONTESTED
             with a hard block, because the app still ships AI-generated
             English while publicly committing to cited public domain sources
             (Nicholson, Whinfield, Bell). The rest of the sentence is the
             approved 2026-07-25 copy, unchanged: the presentation claim, a
             Persian original beside an English translation, is true today.
             Restore an adjective here only once the replacement translations
             have shipped and FACTS.md records them as VERIFIED. */
        }
        <p>
          Every verse arrives in its original Persian beside an English translation, drawn from
          Hafez, Rumi, Saadi, Khayyam and Parvin Etesami.
        </p>
      </div>
    </div>
  </section>

  <JourneyPair lang="en" />

  <SectionDivider />

  {
    /* 3. FIVE POETS
       VerseShowcase is in neither the target structure nor the retire list in
       the handoff, and it carries approved verse content, so it joins the poets
       rather than being dropped: the verse and the five voices behind it are
       one section. Flagged as a judgement call. */
  }
  <VerseShowcase
    lang="en"
    intro="A verse for every morning. Five poets. Two languages. Centuries of wisdom."
    sceneImage={dawn}
  />

  <PoetsBand lang="en" />

  <SectionDivider />

  {/* 4. ROOTS */}
  <RootsMoments lang="en" />

  <SectionDivider />

  {
    /* 5. IN YOUR DAY
       The old "meets you wherever you look" section and the "quiet companions"
       section were the same section: everything Hamdam touches outside its own
       screens. One heading, one grid of eight. The companions prose is retired
       (DRAFT), but its one load-bearing claim, that all of this is optional and
       off until asked for, is kept below in a single sentence. Approved by Ealia
       2026-07-25. */
  }
  <section class="relative bg-gradient-to-b from-peach/15 via-peach/5 to-transparent px-6 py-[var(--spacing-section-mobile)] sm:py-[var(--spacing-section-desktop)]">
    <SceneBackground image={quietGarden} />
    <div data-reveal class="relative mx-auto max-w-[var(--container-reading)]">
      <h2 class="text-balance font-serif text-4xl font-semibold text-indigo sm:text-5xl">
        Hamdam meets you wherever you look.
      </h2>
      <p class="mt-8 font-serif text-xl leading-[1.7] text-indigo/90">
        Ask Siri to start a reflection, hear today's verse, or check your streak. Add a widget to
        your Home Screen. If you wear an Apple Watch, your verse and streak travel with you. If
        you choose, each reflection can be saved to Apple Health as a State of Mind entry, with
        calm music playing alongside through Apple Music.
      </p>
      <p class="mt-6 font-serif text-lg leading-[1.7] text-indigo/70">
        The companions, the calendar and Family Sharing are all optional, and each stays off
        until you ask for it.
      </p>
    </div>
    <div class="mx-auto mt-14 flex max-w-2xl flex-wrap justify-center gap-x-10 gap-y-8">
      <FeatureIcon name="siri" label="Siri" />
      <FeatureIcon name="widget" label="Widgets" />
      <FeatureIcon name="watch" label="Watch" />
      <FeatureIcon name="health" label="Health" />
      <FeatureIcon name="music" label="Music" />
      <FeatureIcon name="companion" label="Companions" />
      <FeatureIcon name="calendar" label="Calendar" />
      <FeatureIcon name="family" label="Family Sharing" />
    </div>
  </section>

  <SectionDivider />

  {/* 6. PRIVACY, now carrying the six signals the constellation used to show */}
  <PrivacyTrust lang="en" />

  {/* 7. PLANS AND CLOSE: one continuous ending, no divider between them */}
  <PlansAndFoundingCompanion lang="en" />
  <FinalCeremony lang="en" />

  <Footer />
</BaseLayout>
